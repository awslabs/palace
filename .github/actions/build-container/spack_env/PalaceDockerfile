{% extends "container/Dockerfile" %}
{% block build_stage %}
ARG SPACK_PACKAGES_COMMIT
# FIXME(awslabs/palace#731): workaround for a Spack spec-groups bug that
# prevents the gcc compiler from being installed. Build-stage only, so the
# runtime image is unaffected. Remove with the spack.yaml `compilers` group
# fix.
#
# noble's default archive does not carry gcc-15 yet; pull it from the
# ubuntu-toolchain-r/test PPA.
RUN apt-get -yqq update && \
    apt-get -yqq install --no-install-recommends software-properties-common && \
    add-apt-repository -y ppa:ubuntu-toolchain-r/test && \
    apt-get -yqq install --no-install-recommends gcc-15 g++-15 gfortran-15 && \
    rm -rf /var/lib/apt/lists/*

RUN spack repo update --commit "$SPACK_PACKAGES_COMMIT" builtin && \
    test "$(git -C "$(spack location --repo builtin)" rev-parse HEAD)" = \
      "$SPACK_PACKAGES_COMMIT"

# Copy inputs needed to install dependencies before the Palace source tree.
COPY spack_repo /opt/palace/spack_repo

# Set up spack repo and apply patches to builtin spack packages
RUN mkdir -p /opt/spack-environment && \
    # Link our local spack repo to /opt/spack-environment
    ln -s /opt/palace/spack_repo /opt/spack-environment/spack_repo && \
    # Add it to spack
    spack repo add /opt/palace/spack_repo/local && \
    # Workaround for https://github.com/spack/spack/issues/51505
    ln -sf $(spack location --repo builtin)/packages/libceed /opt/palace/spack_repo/local/packages/libceed && \
    ln -sf $(spack location --repo builtin)/packages/mfem /opt/palace/spack_repo/local/packages/mfem && \
    # Apply patches to builtin repo
    cd $(cd $(spack location --repo builtin) && git rev-parse --show-toplevel) && \
    for patch in /opt/palace/spack_repo/patches/*.diff; do \
      if [ -f "$patch" ]; then \
        if git apply --check "$patch" 2>/dev/null; then \
          echo "Applying patch: $patch"; \
          git apply "$patch"; \
        elif git apply --reverse --check "$patch" 2>/dev/null; then \
          echo "Patch already applied: $patch"; \
        else \
          echo "Patch does not apply cleanly: $patch" >&2; \
          exit 1; \
        fi; \
      fi; \
    done

# Select the CPU or CUDA root spec only after the shared compiler, package
# repository, and patch layers have been prepared.
ARG PALACE_CUDA
ENV PALACE_CUDA=$PALACE_CUDA

# What we want to install and how we want to install it
# is specified in a manifest file (spack.yaml)
RUN mkdir -p {{ paths.environment }} && \
set -o noclobber \
{{ manifest }} > {{ paths.environment }}/spack.yaml

# FIXME(awslabs/palace#731): remove with the apt step above.
RUN cd {{ paths.environment }} && spack env activate . && \
    spack compiler find

# Keep dependency installation before `COPY .` so Palace source changes can
# reuse this layer. If installation fails partway through, save the exit status,
# push every dependency that did install, perform the usual cleanup, and then
# return the original failure to the workflow.
#
# After pushing the Spack buildcache, remove package tests/provenance, generated
# Python bytecode, documentation, and localization that Palace does not need
# to compile. For CUDA builds, also discard profiling/debugging tools and static
# copies of CUDA libraries that have shared equivalents; nvcc still needs the
# static CUDA runtime while compiling Palace. The final pipeline then finds
# executables (`-perm /111`) and shared libraries in the Spack view, resolves
# and deduplicates their symlink targets, and strips batches of 32 files
# (`-n 32`) in up to one process per CPU (`-P "$(nproc)"`). Doing this here
# reduces the reusable Podman dependency layer and final image. It does not
# reduce the Spack buildcache archives, which are pushed first.
RUN --mount=type=secret,id=github_user \
    --mount=type=secret,id=github_token \
    set -e; \
    GITHUB_USER="$(cat /run/secrets/github_user)"; \
    GITHUB_TOKEN="$(cat /run/secrets/github_token)"; \
    export GITHUB_USER GITHUB_TOKEN; \
    cd {{ paths.environment }}; \
    spack env activate .; \
    install_status=0; \
    spack install --include-build-deps --only dependencies \
      -j$(nproc) --fail-fast || install_status=$?; \
    spack buildcache push --allow-missing --with-build-dependencies \
      --only dependencies --unsigned local-buildcache || true; \
    spack clean --stage --downloads --misc-cache --failures || true; \
    find /opt/software -type d \
      \( -iname doc -o -iname docs -o -iname documentation \
      -o -iname example -o -iname examples -o -iname sample \
      -o -iname samples -o -name __pycache__ \
      -o -path "*/share/man" -o -path "*/share/info" \
      -o -path "*/share/locale" -o -path "*/share/cmake-*/Help" \
      -o -path "*/.spack/test" -o -path "*/.spack/archived-files" \) \
      -prune \
      -exec rm -rf {} + 2>/dev/null || true; \
    if cuda_prefix="$(spack location -i cuda 2>/dev/null)"; then \
      cuda_size_before="$(du -sh "$cuda_prefix" | cut -f1)" || true; \
      find "$cuda_prefix" -mindepth 1 -maxdepth 1 \
        \( -name "nsight-compute-*" -o -name "nsight-systems-*" \
        -o -name nsightee_plugins -o -name compute-sanitizer \
        -o -name extras -o -name gds -o -name nvml -o -name share \
        -o -name src -o -name tools \) \
        -exec rm -rf {} + 2>/dev/null || true; \
      cuda_lib="$(readlink -f "$cuda_prefix/lib64")" || true; \
      find "$cuda_lib" -maxdepth 1 -type f \
        \( -name "*_static.a" -o -name "*_static.alt.a" \) \
        ! -name libcudart_static.a -print | \
        while IFS= read -r archive; do \
          case "$archive" in \
            *_static.alt.a) shared="${archive%_static.alt.a}" ;; \
            *) shared="${archive%_static.a}" ;; \
          esac; \
          if ls "${shared}".so* >/dev/null 2>&1; then \
            rm -f "$archive"; \
          fi; \
        done || true; \
      cuda_size_after="$(du -sh "$cuda_prefix" | cut -f1)" || true; \
      echo "Pruned CUDA build toolkit from ${cuda_size_before} to ${cuda_size_after}"; \
    fi; \
    # The prunes above remove files (docs, static archives, CUDA components)
    # that the Spack view symlinks into, on both the CPU and CUDA paths, so drop
    # the now-dangling links regardless of whether CUDA is installed.
    find {{ paths.view }}/* -type l ! -exec test -e {} \; -delete || true; \
    find -L {{ paths.view }}/* -type f \
      \( -perm /111 -o -name "*.so" -o -name "*.so.*" \) \
      -exec readlink -zf '{}' \; | \
      sort -zu | \
      xargs -0 -r -n 32 -P "$(nproc)" strip 2>/dev/null || true; \
    exit "$install_status"

# Copy the Palace source tree
COPY . /opt/palace

# palace@develop is pinned to branch="main", so every branch shares a spec
# hash with different source. Build Palace --no-cache and never push it to the
# dependency buildcache.
#
# A source change invalidates everything after `COPY .`, so Palace installation
# and all runtime cleanup stay in one layer. This avoids retaining intermediate
# unstripped files in the Podman cache without sacrificing a reusable boundary.
# Cleanup removes unused dependencies, docs/examples, redundant static archives,
# headers except those libCEED and Palace need for runtime JIT, unused CUDA
# toolkit components, debug symbols, and Spack metadata. `set -e` keeps failures
# in required build steps from being hidden by best-effort cleanup commands.
RUN set -e; \
    if [ ! -f /opt/palace/CMakeLists.txt ]; then \
      echo "ERROR: Palace source tree not found in /opt/palace."; \
      echo "Run 'docker build' from the palace repository root."; \
      exit 1; \
    fi; \
    cd {{ paths.environment }}; \
    spack env activate .; \
    spack install --only package --no-cache -j$(nproc) --fail-fast; \
    spack gc -y; \
    find /opt/software -type d \
      \( -iname doc -o -iname docs -o -iname documentation \
      -o -iname example -o -iname examples -o -iname sample \
      -o -iname samples -o -path "*/share/man" \
      -o -path "*/share/info" -o -path "*/share/locale" \) \
      -prune \
      -exec rm -rf {} + 2>/dev/null || true; \
    find /opt/software -name "*.a" -print | while IFS= read -r a; do \
      base="${a%.a}"; \
      if ls "${base}".so* >/dev/null 2>&1; then \
        rm -f "$a"; \
      fi; \
    done || true; \
    find /opt/software -type d -name include \
      -not -path "*/libceed-*/include" \
      -not -path "*/palace-*/include" \
      -exec rm -rf {} + 2>/dev/null || true; \
    if cuda_prefix="$(spack location -i cuda 2>/dev/null)"; then \
      cuda_size_before="$(du -sh "$cuda_prefix" | cut -f1)"; \
      cuda_lib="$(readlink -f "$cuda_prefix/lib64")"; \
      find "$cuda_prefix" -mindepth 1 -maxdepth 1 \
        ! -name ".spack" \
        ! -name "targets" \
        ! -name "lib64" \
        ! -iname "eula*" \
        ! -iname "license*" \
        ! -iname "notice*" \
        ! -name "version*.json" \
        -exec rm -rf {} +; \
      find "$cuda_lib" -mindepth 1 -maxdepth 1 -print | \
        while IFS= read -r path; do \
          base="${path##*/}"; \
          case "$base" in \
            libcublas.so*|libcublasLt.so*|libcudart.so*|libcurand.so*|\
            libcusolver.so*|libcusparse.so*|libnvJitLink.so*|libnvrtc.so*|\
            libnvrtc-builtins.so*) ;; \
            *) rm -rf "$path" ;; \
          esac; \
        done; \
      find "$cuda_prefix" -type l ! -exec test -e {} \; -delete; \
      find "$cuda_prefix" -depth -type d -empty -delete; \
      cuda_size_after="$(du -sh "$cuda_prefix" | cut -f1)"; \
      echo "Pruned CUDA toolkit from ${cuda_size_before} to ${cuda_size_after}"; \
    fi; \
    # The include/static-archive/CUDA prunes above orphan Spack view symlinks on
    # both the CPU and CUDA paths, so drop the dangling links unconditionally.
    find {{ paths.view }}/* -type l ! -exec test -e {} \; -delete || true; \
    find -L {{ paths.view }}/* -type f \
      \( -perm /111 -o -name "*.so" -o -name "*.so.*" -o -name "*.a" \) \
      -exec readlink -zf '{}' \; | \
      sort -zu | \
      xargs -0 -r -n 32 -P "$(nproc)" strip 2>/dev/null || true; \
    spack env activate --sh -d . > activate.sh && \
    find /opt/software -type d -name .spack -prune -exec rm -rf {} + && \
    find {{ paths.environment }} -mindepth 1 -maxdepth 1 \
      ! -name activate.sh -exec rm -rf {} +

{% endblock %}

{% block final_stage %}
# FIXME(awslabs/palace#731): mirror the build-stage PPA install in the final
# image so libstdc++6 there is gcc-15's, matching what palace was built
# against. Remove with the spack.yaml `compilers` group fix.
RUN apt-get -yqq update && \
    apt-get -yqq install --no-install-recommends software-properties-common && \
    add-apt-repository -y ppa:ubuntu-toolchain-r/test && \
    apt-get -yqq install --no-install-recommends libstdc++6 && \
    apt-get -yqq purge --auto-remove -y software-properties-common && \
    rm -rf /var/lib/apt/lists/*
{% endblock %}
