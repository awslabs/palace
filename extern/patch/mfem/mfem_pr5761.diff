+   {
+      Mesh mesh = Mesh::MakeCartesian3D(3, 3, 3, Element::TETRAHEDRON);
+      for (int v = 0; v < mesh.GetNV(); v++)
+      {
+         real_t *x = mesh.GetVertex(v);
+         for (int d = 0; d < 3; d++)
+         {
+            x[d] += 0.02*std::sin(12.9898*v + 78.233*d);
+         }
+      }
+      for (int e = 0; e < mesh.GetNE(); e += 2)
+      {
