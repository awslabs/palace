+/** Rows of the parallel conforming interpolation for the local DOFs and for the
+    ghost DOFs which are actually referenced (masters of local DOFs, rows received
+    from neighbors). Ghost DOFs are numbered over all ghost entities of the
+    ParNCMesh, which include the coarse mesh replicated on every process, so a row
+    for each of them takes memory of the order of the global problem on every
+    process. */
+struct PMatrixRows
+{
+   std::vector<PMatrixRow> local;
+   std::unordered_map<int, PMatrixRow> ghost;
+
+   explicit PMatrixRows(int ndofs) : local(ndofs) {}
+
+   PMatrixRow &operator[](int dof)
+   {
+      return (dof < static_cast<int>(local.size())) ? local[dof] : ghost[dof];
+   }
+};
