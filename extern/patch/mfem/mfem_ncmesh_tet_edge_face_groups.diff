+bool ParNCMesh::EdgeHasForeignNeighbors(int eindex) const
+{
+   // Only local edges have conforming groups; an interior edge of a face
+   // split whose slave faces are all local and unsplit is always a local
+   // edge, which is the only case TraverseTriFace needs answered here.
+   if (eindex < 0 || eindex >= entity_conf_group[1].Size() || eindex >= NEdges)
+   {
+      return false;
+   }
+   // Group 0 is the singleton {MyRank}: any other group means an element of
+   // another rank (possibly a ghost) is attached to this edge.
+   return entity_conf_group[1][eindex] != 0;
+}
+
