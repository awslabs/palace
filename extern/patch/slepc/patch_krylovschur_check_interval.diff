+/*
+   Whether the wanted unlocked Ritz values eps->eigr/eigi[nconv:nev) of the current check are each within
+   tol (relative) of one of the nprev values of the previous check, then store the values [nconv:n) of
+   the current check as the previous ones
+*/
+static PetscErrorCode EPSKrylovSchurSettled_Private(EPS eps,PetscScalar *prevr,PetscScalar *previ,PetscInt *nprev,PetscInt n,PetscBool *settled)
+{
+  PetscInt  i,j;
+  PetscReal d,dmin,a;
+
+  PetscFunctionBegin;
+  *settled = PETSC_TRUE;
+  for (i=eps->nconv;i<PetscMin(eps->nev,n) && *settled;i++) {
+    a = SlepcAbsEigenvalue(eps->eigr[i],eps->eigi[i]);
+    dmin = PETSC_MAX_REAL;
+    for (j=0;j<*nprev;j++) {
+      d = SlepcAbsEigenvalue(eps->eigr[i]-prevr[j],eps->eigi[i]-previ[j]);
+      dmin = PetscMin(dmin,d);
+    }
+    if (!(dmin<=eps->tol*a)) *settled = PETSC_FALSE;
+  }
+  *nprev = n-eps->nconv;
+  for (j=0;j<*nprev;j++) {
+    prevr[j] = eps->eigr[eps->nconv+j];
+    previ[j] = eps->eigi[eps->nconv+j];
+  }
+  PetscFunctionReturn(PETSC_SUCCESS);
+}
+
+/*
+   Whether two of the k converged Ritz values eps->eigr/eigi[0:k), back-transformed, are within a
+   relative distance of 1e-6 of each other: (numerically) multiple eigenvalues, as with symmetries.
+   In exact arithmetic, a Krylov subspace generated from one start vector holds a single vector of
+   the eigenspace of a multiple eigenvalue; the other copies enter it only through rounding errors
+   and inexact applications of the operator, after more steps, so that a check within a cycle can
+   find the wanted Ritz values converged before they appear. wr, wi: work arrays of size >= k
+*/
+static PetscErrorCode EPSKrylovSchurMultiple_Private(EPS eps,PetscInt k,PetscScalar *wr,PetscScalar *wi,PetscBool *multiple)
+{
+  const PetscReal rtol = 1e-6;
+  PetscInt        i,j;
+
+  PetscFunctionBegin;
+  *multiple = PETSC_FALSE;
+  PetscCall(PetscArraycpy(wr,eps->eigr,k));
+  PetscCall(PetscArraycpy(wi,eps->eigi,k));
+  PetscCall(STBackTransform(eps->st,k,wr,wi));
+  for (i=0;i<k && !*multiple;i++) {
+    for (j=i+1;j<k && !*multiple;j++) {
+      if (SlepcAbsEigenvalue(wr[i]-wr[j],wi[i]-wi[j])<=rtol*PetscMax(SlepcAbsEigenvalue(wr[i],wi[i]),SlepcAbsEigenvalue(wr[j],wi[j]))) *multiple = PETSC_TRUE;
+    }
+  }
+  PetscFunctionReturn(PETSC_SUCCESS);
+}
