+static PetscErrorCode EPSKrylovSchurSetCheckInterval_KrylovSchur(EPS eps,PetscInt check)
+{
+  EPS_KRYLOVSCHUR *ctx = (EPS_KRYLOVSCHUR*)eps->data;
+
+  PetscFunctionBegin;
+  if (check==PETSC_DEFAULT || check==PETSC_DECIDE) ctx->check = 0;
+  else {
+    PetscCheck(check>=0,PetscObjectComm((PetscObject)eps),PETSC_ERR_ARG_OUTOFRANGE,"The check interval %" PetscInt_FMT " must be nonnegative",check);
+    ctx->check = check;
+  }
+  PetscFunctionReturn(PETSC_SUCCESS);
+}
