     if ( gstrs_comm->perm_cache ) pxperm_cache_free(gstrs_comm->perm_cache);
+    if ( gstrs_comm->b2x_agg ) pxb2x_agg_free(gstrs_comm->b2x_agg);
     if ( gstrs_comm->comm_L != MPI_COMM_NULL ) {
         int finalized;
