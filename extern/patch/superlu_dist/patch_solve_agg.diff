+void pxb2x_agg_free(pxb2x_agg_t *a)
+{
+    if ( a->enabled ) {
+        SUPERLU_FREE(a->node_lo); /* also holds node_cnt[] and agg_of_q[] */
+        if ( a->nagg ) {
+            SUPERLU_FREE(a->agg_q);
+            SUPERLU_FREE(a->agg_tot);
+            SUPERLU_FREE(a->x2b_tot);
+        }
+    }
+    SUPERLU_FREE(a);
+}
