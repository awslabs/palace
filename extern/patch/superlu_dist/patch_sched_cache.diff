diff --git a/SRC/double/pdgstrf.c b/SRC/double/pdgstrf.c
index 6032d467..21b776aa 100755
--- a/SRC/double/pdgstrf.c
+++ b/SRC/double/pdgstrf.c
@@ -607,8 +607,23 @@ pdgstrf(superlu_dist_options_t * options, int m, int n, double anorm,
     perm_c_supno = SUPERLU_MALLOC (2 * nsupers * sizeof (int_t));
     iperm_c_supno = perm_c_supno + nsupers;
 
-    dstatic_schedule(options, m, n, LUstruct, grid, stat,
-		    perm_c_supno, iperm_c_supno, info);
+    /* The schedule only depends on the structure of L and U: reuse the one of
+       the previous factorization when the pattern and permutations are kept. */
+    if ( options->Fact == SamePattern_SameRowPerm && Llu->sched_perm_c_supno
+         && Llu->sched_nsupers == nsupers ) {
+        memcpy(perm_c_supno, Llu->sched_perm_c_supno,
+               2 * nsupers * sizeof (int_t));
+    } else {
+        dstatic_schedule(options, m, n, LUstruct, grid, stat,
+		        perm_c_supno, iperm_c_supno, info);
+        if ( Llu->sched_perm_c_supno ) SUPERLU_FREE(Llu->sched_perm_c_supno);
+        Llu->sched_perm_c_supno = SUPERLU_MALLOC (2 * nsupers * sizeof (int_t));
+        if ( Llu->sched_perm_c_supno ) {
+            memcpy(Llu->sched_perm_c_supno, perm_c_supno,
+                   2 * nsupers * sizeof (int_t));
+            Llu->sched_nsupers = nsupers;
+        }
+    }
 
 #if ( DEBUGlevel >= 2 )
     PrintInt10("schedule:perm_c_supno", nsupers, perm_c_supno);
diff --git a/SRC/double/pdutil.c b/SRC/double/pdutil.c
