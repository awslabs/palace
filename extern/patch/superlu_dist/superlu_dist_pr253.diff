+                          &reqs[nreq++]);
+        }
+        tot += a->x2b_tot[k];
+    }
+    if ( nreq ) MPI_Waitall(nreq, reqs, MPI_STATUSES_IGNORE);
+    if ( aggbuf ) SUPERLU_FREE(aggbuf);
+    SUPERLU_FREE(reqs);
+}
