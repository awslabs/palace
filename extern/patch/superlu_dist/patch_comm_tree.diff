+/* getenv() is a linear scan of the environment: query it once, not for
+   every message forwarded in the triangular solves. */
+static int comm_tree_mpi_wait(void)
+{
+    static int flag = -1;
+    if (flag < 0) flag = (getenv("COMM_TREE_MPI_WAIT") != NULL);
+    return flag;
+}
