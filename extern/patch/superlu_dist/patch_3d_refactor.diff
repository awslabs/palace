diff --git a/SRC/complex16/pzdistribute3d.c b/SRC/complex16/pzdistribute3d.c
index 97770481..29fa0a6f 100644
--- a/SRC/complex16/pzdistribute3d.c
+++ b/SRC/complex16/pzdistribute3d.c
@@ -354,6 +354,21 @@ pzdistribute3d(superlu_dist_options_t *options, int_t n, SuperMatrix *A,
 			    }
 			} /* for bnnz ... */
 		    } /* for jj ... */
+		} else { /* No L block column on this grid (superGridMap[jb] ==
+			    NOT_IN_GRID): clear the SPA entries set above, like the
+			    first-time distribution does. Otherwise they leak into
+			    the L blocks of the next block columns. */
+		    for (j = fsupc, dense_col = dense; j < FstBlockC(jb+1); ++j) {
+			for (i = xa[j]; i < xa[j+1]; ++i) {
+			    irow = asub[i];
+			    gb = BlockNum( irow );
+			    if ( myrow == PROW( gb, grid ) && gb >= jb ) {
+				lb = LBi( gb, grid );
+				dense_col[ilsum[lb] + irow - FstBlockC( gb )] = zero;
+			    }
+			}
+			dense_col += ldaspa;
+		    }
 		} /* if index ... */
 #if ( PROFlevel>=1 )
 		t_l += SuperLU_timer_() - t;
diff --git a/SRC/complex16/pzgssvx3d.c b/SRC/complex16/pzgssvx3d.c
index 3453b511..cc7d9635 100755
--- a/SRC/complex16/pzgssvx3d.c
+++ b/SRC/complex16/pzgssvx3d.c
@@ -867,6 +867,21 @@ void pzgssvx3d(superlu_dist_options_t *options, SuperMatrix *A,
     MPI_Bcast(&rowequ, 1, MPI_INT, 0, grid3d->zscp.comm);
     MPI_Bcast(&colequ, 1, MPI_INT, 0, grid3d->zscp.comm);
 
+    /* With Fact == SamePattern_SameRowPerm, grid-0 has scaled its copy of A
+       with the previous R and C, but dbcastPermutedSparseA() below is skipped
+       and the other grids distribute their own copy into L and U: send them
+       the scaled values (the copies have the same structure). */
+    if (Fact == SamePattern_SameRowPerm && Equil &&
+        ScalePermstruct->DiagScale != NOEQUIL) {
+	NRformat_loc *As = (NRformat_loc *) A->Store;
+	int_t chunk = 100000000;
+	for (int_t idx = 0; idx < As->nnz_loc; idx += chunk) {
+	    int count = (int) SUPERLU_MIN(chunk, As->nnz_loc - idx);
+	    MPI_Bcast(&(((doublecomplex *) As->nzval)[idx]), count, SuperLU_MPI_DOUBLE_COMPLEX, 0,
+		      grid3d->zscp.comm);
+	}
+    }
+
     /* Now all processes in 3D grid participate */
 
     /* Broadcast Permuted A and symbolic factorization data from 2d to 3d grid */
@@ -959,12 +974,15 @@ void pzgssvx3d(superlu_dist_options_t *options, SuperMatrix *A,
 
 	    }
 
-	    if (Fact != SamePattern_SameRowPerm) {
-		// checkDist3DLUStruct(LUstruct, grid3d);
-		// zeros out the Supernodes that are not owned by the grid
-		zinit3DLUstructForest(trf3Dpartition->myTreeIdxs, trf3Dpartition->myZeroTrIdxs,
-					trf3Dpartition->sForests, LUstruct, grid3d);
+	    // checkDist3DLUStruct(LUstruct, grid3d);
+	    /* Zero out the supernodes that are not owned by this grid. Also needed
+	       for SamePattern_SameRowPerm: the distribution routine above has
+	       refilled L and U with the entries of A on all grids, and the
+	       ancestor reduction of the 3D factorization sums the grids. */
+	    zinit3DLUstructForest(trf3Dpartition->myTreeIdxs, trf3Dpartition->myZeroTrIdxs,
+				    trf3Dpartition->sForests, LUstruct, grid3d);
 
+	    if (Fact != SamePattern_SameRowPerm) {
 		zLUValSubBuf_t *LUvsb = SUPERLU_MALLOC(sizeof(zLUValSubBuf_t));
 		zLluBufInit(LUvsb, LUstruct);
 		trf3Dpartition->LUvsb = LUvsb;
