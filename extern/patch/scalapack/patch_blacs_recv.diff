diff --git a/BLACS/SRC/BI_Srecv.c b/BLACS/SRC/BI_Srecv.c
index 926174f..e66c065 100644
--- a/BLACS/SRC/BI_Srecv.c
+++ b/BLACS/SRC/BI_Srecv.c
@@ -5,6 +5,40 @@ void BI_Srecv(BLACSCONTEXT *ctxt, Int src, Int msgid, BLACBUFF *bp)
    Int i, info;
    extern MPI_Status *BI_Stats;
 
+#ifdef MPICH_VERSION
+/*
+ * Point-to-point messages are sent packed (MPI_PACKED, see BI_Pack) and
+ * received with the datatype of the message, which MPI allows. MPICH (ch4)
+ * fails to unpack a packed message received in several shared memory cells
+ * into a noncontiguous derived datatype when a cell boundary splits one of
+ * its basic elements, as it does for double precision complex elements on
+ * macOS arm64. With MPICH and the MPI implementations derived from it,
+ * messages with derived datatypes are thus received packed and unpacked
+ * locally.
+ */
+   if (bp->dtype != MPI_PACKED)
+   {
+      MpiInt combiner, ni, na, nd;
+      MPI_Type_get_envelope(bp->dtype, &ni, &na, &nd, &combiner);
+      if (combiner != MPI_COMBINER_NAMED)
+      {
+         MpiInt psize, pcount, pos = 0;
+         char *pbuf;
+         MPI_Pack_size(bp->N, bp->dtype, ctxt->scp->comm, &psize);
+         pbuf = (char *) malloc(psize > 0 ? psize : 1);
+         if (pbuf == NULL)
+            BI_BlacsErr(BI_ContxtNum(ctxt), __LINE__, __FILE__,
+                        "Not enough memory to allocate receive buffer\n");
+         info=MPI_Recv(pbuf, psize, MPI_PACKED, src, msgid, ctxt->scp->comm,
+                       BI_Stats);
+         info=MPI_Get_count(BI_Stats, MPI_PACKED, &pcount);
+         info=MPI_Unpack(pbuf, pcount, &pos, bp->Buff, bp->N, bp->dtype,
+                         ctxt->scp->comm);
+         free(pbuf);
+         return;
+      }
+   }
+#endif
    info=MPI_Recv(bp->Buff, bp->N, bp->dtype, src, msgid, ctxt->scp->comm,BI_Stats);
