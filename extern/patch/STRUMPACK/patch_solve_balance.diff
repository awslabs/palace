+    template<typename integer_t, typename LeafF> void
+    pm_dp_tree(integer_t nn, integer_t root, const integer_t* lch,
+               const integer_t* rch, const float* work, std::size_t ld,
+               std::vector<float>& f, LeafF leaf_f) {
