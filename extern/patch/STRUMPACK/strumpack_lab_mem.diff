+        eq.type == EquilibrationType::BOTH) {
+      std::vector<int> cnts(P), displs(P);
+      for (int p=0; p<P; p++) {
+        cnts[p] = dist_[p+1] - dist_[p];
+        displs[p] = dist_[p];
+      }
