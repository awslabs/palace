+  template<typename scalar_t,typename integer_t> void
+  CSRMatrixMPI<scalar_t,integer_t>::column_equilibration(Equil_t& eq) const {
+    real_t small = blas::lamch<real_t>('S');
+    real_t big = 1. / small;
+    auto P = comm_.size();
+    std::vector<real_t> Cloc(lrows_, 0.);
+    {
+      std::vector<std::vector<integer_t>> sind(P);
+      std::vector<std::vector<real_t>> sval(P);
+      for (integer_t r=0; r<lrows_; r++)
+        for (integer_t j=ptr_[r]; j<ptr_[r+1]; j++) {
+          auto c = ind_[j];
+          auto v = std::abs(val_[j]) * eq.R[r];
+          if (c >= brow_ && c < brow_ + lrows_)
+            Cloc[c-brow_] = std::max(Cloc[c-brow_], v);
+          else {
+            auto p = std::upper_bound(dist_.begin(), dist_.end(), c)
+              - dist_.begin() - 1;
+            sind[p].push_back(c);
+            sval[p].push_back(v);
+          }
+        }
+      auto rind = comm_.all_to_all_v(sind);
+      auto rval = comm_.all_to_all_v(sval);
+      for (std::size_t k=0; k<rind.size(); k++) {
+        auto& ck = Cloc[rind[k]-brow_];
+        ck = std::max(ck, rval[k]);
+      }
+    }
+    auto mM = std::minmax_element(Cloc.begin(), Cloc.end());
+    real_t cmin = lrows_ ? *(mM.first) : std::numeric_limits<real_t>::max();
+    real_t cmax = lrows_ ? *(mM.second) : 0;
