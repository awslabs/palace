+++ b/src/dense/DistTrsmNarrow.hpp
@@ -0,0 +1,788 @@
+// Distributed triangular solve with a narrow right-hand side, op(A) X = B with
+// SIDE = L and TRANS = N, A an m x m block-cyclic matrix (square nb x nb
+// blocks, source process (0,0)) and B an m x n block-cyclic matrix with the
+// same row blocking and n <= nb, i.e., B lives in process column 0.
+//
+// The local computations are exactly those of the PBLAS routine
+// PDTRSM (PB_CptrsmB + PB_Cptrsm, lookahead variant): the same BLAS calls on
+// the same data in the same order, so the result is bitwise identical. Only
+// the communication differs: BLACS point-to-point and ring broadcasts are
+// replaced by direct MPI messages on contiguous buffers, and the final
+// row-wise combine of the solution (a sum with exact zeros) is replaced by
+// sending each solved block to process column 0.
+#ifndef STRUMPACK_DIST_TRSM_NARROW_HPP
+#define STRUMPACK_DIST_TRSM_NARROW_HPP
+
+#include <mpi.h>
+#include <vector>
+#include <algorithm>
+#include <deque>
+#include <map>
+
+#include "BLASLAPACKWrapper.hpp"
+#include "ScaLAPACKWrapper.hpp"
+
+
+namespace strumpack {
+  namespace trsmnarrow {
+
+
+    // block-cyclic index helpers, same as the PBLAS tools
+    inline int numroc(int N, int I, int INB, int NB, int PROC, int SRCPROC,
+                      int NPROCS) {
+      int ilocblk, mydist, nblocks;
+      if (SRCPROC == -1 || NPROCS == 1) return N;
+      if ((INB -= I) <= 0) {
+        nblocks = (-INB) / NB + 1;
+        SRCPROC += nblocks;
+        SRCPROC -= (SRCPROC / NPROCS) * NPROCS;
+        INB += nblocks * NB;
+      }
+      if (PROC == SRCPROC) {
+        if (N <= INB) return N;
+        nblocks = (N - INB) / NB + 1;
+        if (nblocks < NPROCS) return INB;
+        ilocblk = nblocks / NPROCS;
+        return (nblocks - ilocblk * NPROCS) ? INB + ilocblk * NB :
+          N + (ilocblk - nblocks) * NB;
+      } else {
+        if (N <= INB) return 0;
+        nblocks = (N - INB) / NB + 1;
+        if ((mydist = PROC - SRCPROC) < 0) mydist += NPROCS;
+        if (nblocks < NPROCS)
+          return (mydist < nblocks) ? NB : ((mydist > nblocks) ? 0 :
+                                            N - INB + NB * (1 - nblocks));
+        ilocblk = nblocks / NPROCS;
+        mydist -= nblocks - ilocblk * NPROCS;
+        return (mydist < 0) ? (ilocblk + 1) * NB :
+          ((mydist > 0) ? ilocblk * NB :
+           N - INB + NB * (ilocblk - nblocks + 1));
+      }
+    }
+    inline int indxg2p(int IG, int INB, int NB, int, int SRCPROC,
+                       int NPROCS) {
+      if (IG < INB || SRCPROC == -1 || NPROCS == 1) return SRCPROC;
+      int p = SRCPROC + 1 + (IG - INB) / NB;
+      return p - (p / NPROCS) * NPROCS;
+    }
+    inline int firstnb(int N, int I, int INB, int NB) {
+      int inbt = ((INB -= I) <= 0 ? ((-INB) / NB + 1) * NB + INB : INB);
+      return std::min(inbt, N);
+    }
+    inline int lastnb(int N, int I, int INB, int NB) {
+      int lnbt = I + N - INB;
+      if (lnbt > 0) {
+        lnbt = lnbt - NB * ((NB + lnbt - 1) / NB - 1);
+        return std::min(lnbt, N);
+      }
+      return N;
+    }
+    inline bool span(int N, int I, int INB, int NB, int SRCPROC,
+                     int NPROCS) {
+      return (SRCPROC >= 0) &&
+        ((NPROCS > 1) &&
+         ((I < INB) ? (I + N > INB) :
+          (I + N > INB + ((I - INB) / NB + 1) * NB)));
+    }
+    inline void g2l1(int I, int imb, int mb, int src, int NP, int ME,
+                     int& II, int& P) {
+      // one dimension of PB_Cinfog2l
+      P = src;
+      if (P == -1 || NP == 1) { II = I; return; }
+      if (I < imb) { II = (ME == P ? I : 0); return; }
+      int nblocks, ilocblk, mydist;
+      if (ME == src) {
+        nblocks = (I - imb) / mb + 1;
+        P += nblocks; P -= (P / NP) * NP;
+        if (nblocks < NP) II = imb;
+        else {
+          ilocblk = nblocks / NP;
+          if (ilocblk * NP >= nblocks)
+            II = (ME == P) ? I + (ilocblk - nblocks) * mb :
+              imb + (ilocblk - 1) * mb;
+          else II = imb + ilocblk * mb;
+        }
+      } else {
+        nblocks = (I -= imb) / mb + 1;
+        P += nblocks; P -= (P / NP) * NP;
+        if ((mydist = ME - src) < 0) mydist += NP;
+        if (nblocks < NP) {
+          mydist -= nblocks;
+          II = (mydist < 0) ? mb : ((ME == P) ? I + (1 - nblocks) * mb : 0);
+        } else {
+          ilocblk = nblocks / NP;
+          mydist -= nblocks - ilocblk * NP;
+          II = (mydist < 0) ? (ilocblk + 1) * mb :
+            ((ME == P) ? (ilocblk - nblocks + 1) * mb + I : ilocblk * mb);
+        }
+      }
+    }
+    // logical block size of the PBLAS (PILAENV), which sets the size of the
+    // diagonal blocks PB_CptrsmB hands to PB_Cptrsm (2 * nb * lcm(P, Q))
+    constexpr int pblas_nb = 32;
+
+    inline int gcd(int a, int b) { while (b) { int t = a % b; a = b; b = t; } return a; }
+    inline int lcm(int a, int b) { return a / gcd(a, b) * b; }
+
+    struct Grid {
+      int nprow, npcol, myrow, mycol, ctxt;
+      MPI_Comm comm; // ranks in column-major grid order
+      int rank(int r, int c) const { return r + c * nprow; }
+    };
+
+    // descriptor of the (square) matrix A as used by PB_Cptrsm (Ad0)
+    struct Desc { int imb, inb, mb, nb, rsrc, csrc, lld; };
+
+    // true iff PDTRSM (SIDE = L, TRANS = N, A and B with nb x nb blocks
+    // starting in process (0,0)) uses PB_CptrsmB, which Solver reproduces
+    inline bool applicable(int M, int N, int nb, int nprow, int npcol) {
+      if (N > nb || M <= 0 || N <= 0) return false;
+      auto dnroc = [](int n, int b, int p) {
+        return (double)((((n + b - 1) / b) + p - 1) / p) * (double)b;
+      };
+      double tmp1 = dnroc(M, nb, nprow), tmp4 = dnroc(N, nb, npcol);
+      double ABestR = (double)M *
+        ((npcol == 1 ? 0. : tmp1 / 2.) + (nprow == 1 ? 0. : tmp4));
+      double Best = (double)N *
+        ((double)((M + nb - 1) / nb) * (double)nb * (nprow == 1 ? 0. : 1.) +
+         (npcol == 1 ? 0. : 1.));
+      bool ChooseAB = (ABestR <= 2.0 * Best);
+      return !ChooseAB;
+    }
+
+    // copies of the blocks of A used by the window chains (see
+    // Solver::cptrsm_fanin), valid until A changes
+    struct Cache {
+      std::map<std::pair<int,long long>, std::vector<double>> L;
+      bool built = false;
+    };
+
+    class Solver {
+    public:
+      Solver(const Grid& g, bool upper, bool unit)
+        : g_(g), upper_(upper), unit_(unit) {}
+
+      // B is overwritten with the solution (process column 0 only)
+      void solve(int m, int n, int nb, const double* A, int lda,
+                 double* B, int ldb) {
+        const int nprow = g_.nprow, npcol = g_.npcol,
+          myrow = g_.myrow, mycol = g_.mycol;
+        const int An = m, nbb = n;
+        // sub(A) descriptor (PB_Cdescribe with IA = JA = 0)
+        const int Aimb1 = firstnb(An, 0, nb, nb), Ainb1 = firstnb(An, 0, nb, nb);
+        Desc Ad0{Aimb1, Ainb1, nb, nb, 0, 0, lda};
+        const int Amb = nb, Anb = nb, Arow = 0, Acol = 0, Ald = lda;
+        const int Anp = numroc(An, 0, Aimb1, Amb, myrow, Arow, nprow);
+        const int Anq = numroc(An, 0, Ainb1, Anb, mycol, Acol, npcol);
+        // WBC (PB_CInOutV2, column vector, reuse of B in process column 0)
+        double* WBC = nullptr; int WBCld = 1; bool WBCsum = false;
+        std::vector<double> wbc;
+        if (span(An, 0, Ainb1, Anb, Acol, npcol)) {
+          WBCsum = (npcol > 1);
+          // the data of B is wanted in the process column owning column
+          // Astart of A (the last one for the backward solve)
+          const int Acoldst = indxg2p(upper_ ? An - 1 : 0, Ainb1, Anb,
+                                      Acol, Acol, npcol);
+          if (mycol == 0) {
+            WBCld = ldb;
+            if (Anp > 0) {
+              WBC = B;
+              if (Acoldst != 0) {
+                isend(B, Anp, nbb, ldb, g_.rank(myrow, Acoldst), tag_b0);
+                zero(Anp, nbb, B, ldb);
+              }
+            }
+          } else {
+            WBCld = std::max(1, Anp);
+            if (Anp > 0) {
+              wbc.assign(std::size_t(Anp) * nbb, 0.); WBC = wbc.data();
+              if (mycol == Acoldst)
+                recv(WBC, Anp, nbb, WBCld, g_.rank(myrow, 0), tag_b0);
+            }
+          }
+        } else {
+          WBCld = ldb;
+          if (mycol == 0 && Anp > 0) WBC = B;
+        }
+        // WBR (PB_COutV, row vector, zero initialized)
+        bool WBRsum = false;
+        std::vector<double> wbr;
+        double* WBR = nullptr; const int WBRld = std::max(1, nbb);
+        if (nprow == 1 || span(An, 0, Aimb1, Amb, Arow, nprow)) {
+          WBRsum = (nprow > 1);
+          if (Anq > 0) { wbr.assign(std::size_t(nbb) * Anq, 0.); WBR = wbr.data(); }
+        } else {
+          if (myrow == Arow && Anq > 0) {
+            wbr.assign(std::size_t(nbb) * Anq, 0.); WBR = wbr.data();
+          }
+        }
+        wbc_sum_ = WBCsum;
+        if (!cache_) fanin_ = false;
+        if (fanin_ && !cache_->built) {
+          build_lcache(An, nb, A, lda);
+          cache_->built = true;
+        }
+        const int Alcmb = 2 * pblas_nb * lcm(nprow, npcol);
+        const double* Aptr = (Anp > 0 && Anq > 0) ? A : nullptr;
+        auto Ap = [&](int i, int j) { return Aptr + i + std::size_t(j) * Ald; };
+        auto gemmNT = [&](int M, int K, const double* a, const double* br,
+                          double* c) {
+          blas::gemm('N', 'T', M, nbb, K, -1., a, Ald, br, WBRld, 1., c, WBCld);
+        };
+        auto pad = [&](int M, double* c) {
+          for (int j=0; j<nbb; j++)
+            std::fill(c + std::size_t(j)*WBCld, c + std::size_t(j)*WBCld + M, 0.);
+        };
+        if (!upper_) {
+          for (int k=0; k<An; k+=Alcmb) {
+            int ktmp = An - k, kb = std::min(ktmp, Alcmb);
+            int Akp = numroc(k, 0, Aimb1, Amb, myrow, Arow, nprow);
+            int Akq = numroc(k, 0, Ainb1, Anb, mycol, Acol, npcol);
+            cptrsm(WBRsum, kb, nbb, Aptr, k, k, Ad0,
+                   WBC ? WBC + Akp : nullptr, WBCld,
+                   WBR ? WBR + std::size_t(Akq) * WBRld : nullptr, WBRld);
+            Akp = numroc(k+kb, 0, Aimb1, Amb, myrow, Arow, nprow);
+            int Anp0 = Anp - Akp;
+            if (Anp0 > 0) {
+              int Anq0 = numroc(kb, k, Ainb1, Anb, mycol, Acol, npcol);
+              double* wbr = WBR ? WBR + std::size_t(Akq) * WBRld : nullptr;
+              if (WBCsum) {
+                int kbnext = std::min(ktmp - kb, Alcmb);
+                ktmp = numroc(kbnext, k+kb, Aimb1, Amb, myrow, Arow, nprow);
+                Anp0 -= ktmp;
+                if (ktmp > 0) {
+                  if (Anq0 > 0) gemmNT(ktmp, Anq0, Ap(Akp, Akq), wbr, WBC + Akp);
+                  int Asrc = indxg2p(k+kb, Ainb1, Anb, Acol, Acol, npcol);
+                  scalapack::gsum2d(g_.ctxt, 'R', ' ', ktmp, nbb, WBC + Akp, WBCld, myrow, Asrc);
+                  if (mycol != Asrc) pad(ktmp, WBC + Akp);
+                }
+                if (Anp0 > 0 && Anq0 > 0)
+                  gemmNT(Anp0, Anq0, Ap(Akp+ktmp, Akq), wbr, WBC + Akp + ktmp);
+              } else if (Anq0 > 0)
+                gemmNT(Anp0, Anq0, Ap(Akp, Akq), wbr, WBC + Akp);
+            }
+          }
+        } else {
+          const int Astart = An - 1;
+          for (int k=(Astart / Alcmb) * Alcmb; k>=0; k-=Alcmb) {
+            int ktmp = An - k, kb = std::min(ktmp, Alcmb);
+            int Akp = numroc(k, 0, Aimb1, Amb, myrow, Arow, nprow);
+            int Akq = numroc(k, 0, Ainb1, Anb, mycol, Acol, npcol);
+            cptrsm(WBRsum, kb, nbb, Aptr, k, k, Ad0,
+                   WBC ? WBC + Akp : nullptr, WBCld,
+                   WBR ? WBR + std::size_t(Akq) * WBRld : nullptr, WBRld);
+            if (Akp > 0) {
+              int Anq0 = numroc(kb, k, Ainb1, Anb, mycol, Acol, npcol);
+              double* wbr = WBR ? WBR + std::size_t(Akq) * WBRld : nullptr;
+              if (WBCsum) {
+                int kbprev = std::min(k, Alcmb);
+                ktmp = numroc(kbprev, k - kbprev, Aimb1, Amb, myrow, Arow, nprow);
+                Akp -= ktmp;
+                if (ktmp > 0) {
+                  if (Anq0 > 0) gemmNT(ktmp, Anq0, Ap(Akp, Akq), wbr, WBC + Akp);
+                  int Asrc = indxg2p(k-1, Ainb1, Anb, Acol, Acol, npcol);
+                  scalapack::gsum2d(g_.ctxt, 'R', ' ', ktmp, nbb, WBC + Akp, WBCld, myrow, Asrc);
+                  if (mycol != Asrc) pad(ktmp, WBC + Akp);
+                }
+                if (Akp > 0 && Anq0 > 0)
+                  gemmNT(Akp, Anq0, Ap(0, Akq), wbr, WBC);
+              } else if (Anq0 > 0)
+                gemmNT(Akp, Anq0, Ap(0, Akq), wbr, WBC);
+            }
+          }
+        }
+        // the final combine of WBC over process rows: only the column
+        // owning a diagonal block holds nonzeros for its rows, so process
+        // column 0 receives the solved blocks it does not own (0 + x, like
+        // the sum with exact zeros)
+        if (WBCsum && mycol == 0 && Anp > 0) {
+          const int nblk = (An + nb - 1) / nb;
+          std::vector<double> tmp;
+          for (int t=0; t<nblk; t++) {
+            int b = upper_ ? nblk - 1 - t : t;
+            if (b % nprow != myrow || b % npcol == 0) continue;
+            int kb = std::min(nb, An - b * nb), off = (b / nprow) * nb;
+            tmp.resize(std::size_t(kb) * nbb);
+            MPI_Recv(tmp.data(), tmp.size(), MPI_DOUBLE,
+                     g_.rank(myrow, b % npcol), tag_x, g_.comm, MPI_STATUS_IGNORE);
+            for (int j=0; j<nbb; j++)
+              for (int i=0; i<kb; i++)
+                B[off + i + std::size_t(j)*ldb] += tmp[i + std::size_t(j)*kb];
+          }
+        }
+        wait_all();
+      }
+
+    private:
+      Grid g_;
+      bool upper_, unit_;
+
+      bool wbc_sum_ = false;
+      std::deque<std::vector<double>> sbufs_;
+      std::vector<MPI_Request> sreqs_;
+      static const int tag_win = 7361, tag_bc = 7362, tag_x = 7363, tag_b0 = 7364,
+        tag_own = 7365, tag_x2 = 7366, tag_l = 7367;
+
+      void isend(const double* a, int m, int n, int lda, int dest, int tag) {
+        sbufs_.emplace_back(std::size_t(m) * n);
+        auto& b = sbufs_.back();
+        for (int j=0; j<n; j++)
+          std::copy(a + std::size_t(j)*lda, a + std::size_t(j)*lda + m,
+                    b.data() + std::size_t(j)*m);
+        sreqs_.emplace_back();
+        MPI_Isend(b.data(), b.size(), MPI_DOUBLE, dest, tag, g_.comm,
+                  &sreqs_.back());
+      }
+      void recv(double* a, int m, int n, int lda, int src, int tag) {
+        if (lda == m || n == 1)
+          MPI_Recv(a, m*n, MPI_DOUBLE, src, tag, g_.comm, MPI_STATUS_IGNORE);
+        else {
+          std::vector<double> b(std::size_t(m) * n);
+          MPI_Recv(b.data(), b.size(), MPI_DOUBLE, src, tag, g_.comm,
+                   MPI_STATUS_IGNORE);
+          for (int j=0; j<n; j++)
+            std::copy(b.data() + std::size_t(j)*m, b.data() + std::size_t(j+1)*m,
+                      a + std::size_t(j)*lda);
+        }
+      }
+      void wait_all() {
+        if (!sreqs_.empty())
+          MPI_Waitall(sreqs_.size(), sreqs_.data(), MPI_STATUSES_IGNORE);
+        sreqs_.clear();
+        sbufs_.clear();
+      }
+      // broadcast of the Nb x kb row piece BR along the process column
+      void bsend(int Nb, int kb, const double* BR, int LDBR) {
+        const int myrow = g_.myrow, mycol = g_.mycol, P = g_.nprow;
+        sbufs_.emplace_back(std::size_t(Nb) * kb);
+        auto& b = sbufs_.back();
+        for (int j=0; j<kb; j++)
+          std::copy(BR + std::size_t(j)*LDBR, BR + std::size_t(j)*LDBR + Nb,
+                    b.data() + std::size_t(j)*Nb);
+        for (int d=1; d<P; d++) {
+          int r = upper_ ? (myrow - d + P) % P : (myrow + d) % P;
+          sreqs_.emplace_back();
+          MPI_Isend(b.data(), b.size(), MPI_DOUBLE, g_.rank(r, mycol), tag_bc,
+                    g_.comm, &sreqs_.back());
+        }
+      }
+      void brecv(int Nb, int kb, double* BR, int LDBR, int srow) {
+        recv(BR, Nb, kb, LDBR, g_.rank(srow, g_.mycol), tag_bc);
+      }
+      void tadd(int M, int N, const double* BC, int LDBC, double* BR, int LDBR) {
+        // BR(N x M) := BC(M x N)^T  (PBLAS mmtadd with alpha 1, beta 0)
+        for (int j=0; j<N; j++)
+          for (int i=0; i<M; i++)
+            BR[j + std::size_t(i)*LDBR] = BC[i + std::size_t(j)*LDBC];
+      }
+      void add(int M, int N, const double* W, int LDW, double* B, int LDB) {
+        // PBLAS mmadd with alpha = beta = 1: daxpy per column
+        for (int j=0; j<N; j++)
+          blas::axpy(M, 1., const_cast<double*>(W + std::size_t(j)*LDW), 1,
+                     B + std::size_t(j)*LDB, 1);
+      }
+      void zero(int M, int N, double* B, int LDB) {
+        for (int j=0; j<N; j++)
+          std::fill(B + std::size_t(j)*LDB, B + std::size_t(j)*LDB + M, 0.);
+      }
+
+      // PB_Cptrsm, Left + No transpose, ALPHA = 1
+      void cptrsm(bool FBCAST, int M, int N, const double* Abase, int IA,
+                  int JA, const Desc& d, double* BC, int LDBC, double* BR,
+                  int LDBR) {
+        if (M <= 0 || N <= 0) return;
+        const int nprow = g_.nprow, npcol = g_.npcol,
+          myrow = g_.myrow, mycol = g_.mycol;
+        const char diag = unit_ ? 'U' : 'N';
+        const char uplo = upper_ ? 'U' : 'L';
+        int Na = M, Nb = N, Aii, Ajj, Arow, Acol;
+        g2l1(IA, d.imb, d.mb, d.rsrc, nprow, myrow, Aii, Arow);
+        g2l1(JA, d.inb, d.nb, d.csrc, npcol, mycol, Ajj, Acol);
+        const int Amb = d.mb, Anb = d.nb, Ald = d.lld;
+        const int Aimb1 = firstnb(Na, IA, d.imb, Amb);
+        int Anp = numroc(Na, 0, Aimb1, Amb, myrow, Arow, nprow);
+        const bool Ais1Row = !span(Na, 0, Aimb1, Amb, Arow, nprow);
+        const int Ainb1 = firstnb(Na, JA, d.inb, Anb);
+        int Anq = numroc(Na, 0, Ainb1, Anb, mycol, Acol, npcol);
+        const bool Ais1Col = !span(Na, 0, Ainb1, Anb, Acol, npcol);
+        // offsets (in elements) instead of pointers
+        const std::ptrdiff_t A0 = Aii + std::ptrdiff_t(Ajj) * Ald;
+        if (Ais1Row && Ais1Col) {
+          if (Anq > 0) {
+            if (Anp > 0) {
+              blas::trsm('L', uplo, 'N', diag, M, N, 1., Abase + A0, Ald, BC, LDBC);
+              tadd(M, N, BC, LDBC, BR, LDBR);
+              note_solved(Acol, BC, M, N, LDBC, 0);
+            }
+            if (Arow >= 0 && FBCAST) {
+              if (myrow == Arow) bsend(N, M, BR, LDBR);
+              else brecv(N, M, BR, LDBR, Arow);
+            }
+          }
+          return;
+        }
+        if (Anq <= 0 || (Ais1Row && (Arow >= 0 && !FBCAST && myrow != Arow)))
+          return;
+        if (fanin_ && !Ais1Row && !Ais1Col && Arow >= 0 && Acol >= 0 &&
+            npcol <= nprow &&
+            Aimb1 == Amb && Ainb1 == Anb && Amb == Anb) {
+          cptrsm_fanin(M, N, Abase, IA, A0, Arow, Acol, Anp, Ald, Amb,
+                       BC, LDBC, BR, LDBR);
+          return;
+        }
+        const bool bcst = (!Ais1Row) || (Ais1Row && Arow >= 0 && FBCAST);
+        const bool AisRowRep = (Arow < 0 || nprow == 1);
+        // A, Aprev, BC, Bprev, BR, Bd, Bdprev as offsets
+        std::ptrdiff_t A = A0, Aprev, Bc = 0, Bprev, Br = 0, Bd = 0, Bdprev;
+        if (!upper_) {
+          const int n1 = (std::max(npcol, 2) - 1) * Anb;
+          std::vector<double> work(std::size_t(Nb) * std::max(1, std::min(n1, Anp)));
+          Aprev = A; Bprev = Bc; Bdprev = Br; int Anpprev = Anp;
+          int mb1 = Aimb1, nb1 = Ainb1, rocprev = Acol;
+          int kb, tmp1, tmp2;
+          tmp1 = Na - (kb = std::min(mb1, nb1)); tmp2 = n1 + nb1 - kb;
