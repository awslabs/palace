+            } else {
+              if (!Ais1Col && (AisRowRep || myrow == Arow))
+                zero(kb, Nb, BC + Bc, LDBC);
+            }
+            if ((Ais1Col || mycol == rocprev) && kbprev > 0) {
+              if ((tmp1 = Anpprev - n1pprev) > 0)
+                blas::gemm('N', 'T', tmp1, Nb, kbprev, -1., Abase + Aprev + n1pprev, Ald, BR + Bdprev, LDBR, 1., BC + Bprev + n1pprev, LDBC);
+              Aprev += std::ptrdiff_t(Ald) * kbprev;
+            }
+            if (Ais1Col || mycol == Acol) {
+              A += std::ptrdiff_t(Ald) * kb; Bdprev = Bd = Br;
+              Br += std::ptrdiff_t(LDBR) * kb;
+            }
+            if (AisRowRep || myrow == Arow) {
+              Bprev = (Bc += kb); A += kb; Aprev += kb; Anpprev = (Anp -= kb);
+            }
+            n1pprev = n1p; rocprev = Acol; kbprev = kb; k += kb; Na -= kb;
+            mb1 -= kb;
+            if (mb1 == 0) {
+              if (!Ais1Row && Arow >= 0) Arow = (Arow == nprow-1) ? 0 : Arow+1;
+              mb1 = std::min(Amb, Na);
+            }
+            nb1 -= kb;
+            ChangeRoc = (nb1 == 0);
+            if (ChangeRoc) {
+              if (!Ais1Col && Acol >= 0) Acol = (Acol == npcol-1) ? 0 : Acol+1;
+              nb1 = std::min(Anb, Na);
+            }
+            tmp1 = Na - (kb = std::min(mb1, nb1)); tmp2 = n1 + nb1 - kb;
+            n1p = numroc(std::min(tmp2, tmp1), k + kb, Aimb1, Amb, myrow, Asrc, nprow);
+          }
+        } else {
+          int nlast = (npcol - 1) * Anb;
+          int n1 = std::max(nlast, Anb);
+          nlast += Ainb1;
+          const int n1last = n1 - Anb + std::max(Ainb1, Anb);
+          std::vector<double> work(std::size_t(Nb) * std::max(1, std::min(n1last, Anp)));
+          int tmp1 = Na - 1;
+          int Alrow = indxg2p(tmp1, Aimb1, Amb, Arow, Arow, nprow);
+          int Alcol = indxg2p(tmp1, Ainb1, Anb, Acol, Acol, npcol);
+          int rocprev = Alcol, Anpprev = Anp;
+          Bprev = Bc; Bdprev = Br;
+          Aprev = A = A0 + std::ptrdiff_t(Anq) * Ald;
+          int mb1 = lastnb(Na, 0, Aimb1, Amb);
+          int nb1 = lastnb(Na, 0, Ainb1, Anb);
+          int kb;
+          tmp1 = Na - (kb = std::min(mb1, nb1));
+          n1 = ((Ais1Col || (Na - nb1 < nlast)) ? n1last : n1);
+          int tmp2 = n1 + nb1 - kb; tmp1 -= (tmp2 = std::min(tmp1, tmp2));
+          const int Asrc = Arow;
+          int n1p = numroc(tmp2, std::max(0, tmp1), Aimb1, Amb, myrow, Asrc, nprow);
+          int n1pprev = 0, kbprev = 0, k = 0; bool ChangeRoc = false;
+          while (Na > 0) {
+            if (Ais1Col || mycol == Alcol) {
+              A -= std::ptrdiff_t(Ald) * kb; Anq -= kb;
+              Bd = Br + std::ptrdiff_t(Anq) * LDBR;
+            }
+            if (Arow < 0 || myrow == Alrow) { Anp -= kb; }
+            if (n1pprev > 0) {
+              if ((Ais1Col || mycol == rocprev) && kbprev > 0) {
+                std::ptrdiff_t t = Anpprev - n1pprev;
+                blas::gemm('N', 'T', n1pprev, Nb, kbprev, -1., Abase + Aprev + t, Ald, BR + Bdprev, LDBR, 1., BC + Bprev + t, LDBC);
+              }
+              if (!Ais1Col && ChangeRoc) {
+                if (mycol == rocprev)
+                  isend(BC + Bprev + (Anpprev - n1pprev), n1pprev, Nb, LDBC,
+                        g_.rank(myrow, Alcol), tag_win);
+                else if (mycol == Alcol) {
+                  recv(work.data(), n1pprev, Nb, n1pprev, g_.rank(myrow, rocprev), tag_win);
+                  add(n1pprev, Nb, work.data(), n1pprev,
+                      BC + Bprev + (Anpprev - n1pprev), LDBC);
+                }
+              }
+            }
+            if (Ais1Col || mycol == Alcol) {
+              if (AisRowRep || myrow == Alrow) {
+                blas::trsm('L', uplo, 'N', diag, kb, Nb, 1., Abase + A + Anp, Ald, BC + Bc + Anp, LDBC);
+                tadd(kb, Nb, BC + Bc + Anp, LDBC,
+                     BR + Br + std::ptrdiff_t(Anq) * LDBR, LDBR);
+              }
+              if (bcst) {
+                if (myrow == Alrow)
+                  bsend(Nb, kb, BR + Br + std::ptrdiff_t(Anq) * LDBR, LDBR);
+                else brecv(Nb, kb, BR + Br + std::ptrdiff_t(Anq) * LDBR, LDBR, Alrow);
+              }
+              if (AisRowRep || myrow == Alrow)
+                note_solved(Alcol, BC + Bc + Anp, kb, Nb, LDBC, 0);
+            } else {
+              if (!Ais1Col && (AisRowRep || myrow == Alrow))
+                zero(kb, Nb, BC + Bc + Anp, LDBC);
+            }
+            if ((Ais1Col || mycol == rocprev) && kbprev > 0) {
+              if ((tmp1 = Anpprev - n1pprev) > 0)
+                blas::gemm('N', 'T', tmp1, Nb, kbprev, -1., Abase + Aprev, Ald, BR + Bdprev, LDBR, 1., BC + Bprev, LDBC);
+            }
+            if (Ais1Col || mycol == Alcol) { Bdprev = Bd; Aprev = A; }
+            if (AisRowRep || myrow == Alrow) { Anpprev -= kb; }
+            n1pprev = n1p; rocprev = Alcol; kbprev = kb; k += kb; Na -= kb;
+            mb1 -= kb;
+            if (mb1 == 0) {
+              if (!Ais1Row && Alrow >= 0) Alrow = (Alrow == 0) ? nprow-1 : Alrow-1;
+              mb1 = (Na > Aimb1 ? Amb : Aimb1);
+            }
+            nb1 -= kb;
+            ChangeRoc = (nb1 == 0);
+            if (ChangeRoc) {
+              if (!Ais1Col && Alcol >= 0) Alcol = (Alcol == 0) ? npcol-1 : Alcol-1;
+              nb1 = (Na > Ainb1 ? Anb : Ainb1);
+            }
+            tmp1 = Na - (kb = std::min(mb1, nb1));
+            n1 = ((Ais1Col || (Na - nb1 < nlast)) ? n1last : n1);
+            tmp2 = n1 + nb1 - kb; tmp1 -= (tmp2 = std::min(tmp1, tmp2));
+            n1p = numroc(tmp2, std::max(0, tmp1), Aimb1, Amb, myrow, Asrc, nprow);
+          }
