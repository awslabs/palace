+
+    public:
+      bool fanin_ = true;
+      // copies of the off-diagonal blocks used by the chains, per logical
+      // block start IA and block pair (i, j) -> nb x nb (ld kb_i)
+      Cache* cache_ = nullptr;
+    private:
+      // Same arithmetic as the lookahead loop of PB_Cptrsm (general case,
+      // A spanning several process rows and columns, aligned square blocks),
+      // reorganized so that the window ("partial update") of each diagonal
+      // block is accumulated by the process owning that diagonal block:
+      // the original sends the partially updated window from column to
+      // column (1 hop) after the column received the solution piece (1
+      // hop). Here the owner of block i receives the partial sums of every
+      // column of its window early ("own" values, final before they are
+      // needed) and applies the window updates itself with copies of the
+      // corresponding blocks of A, in the same order and with the same
+      // BLAS calls: one hop per diagonal block on the critical path.
+      void cptrsm_fanin(int M, int N, const double* Abase, int IA,
+                        std::ptrdiff_t A0, int Arow, int Acol, int Anp,
+                        int Ald, int nb, double* BC, int LDBC, double* BR,
+                        int LDBR) {
+        const int nprow = g_.nprow, npcol = g_.npcol,
+          myrow = g_.myrow, mycol = g_.mycol;
+        const char diag = unit_ ? 'U' : 'N';
+        const char uplo = upper_ ? 'U' : 'L';
+        const int nbl = (M + nb - 1) / nb, Pc = npcol;
+        auto blk = [&](int q) { return upper_ ? nbl - 1 - q : q; };
+        auto kbs = [&](int t) { return std::min(nb, M - t * nb); };
+        auto rowof = [&](int t) { return (Arow + t) % nprow; };
+        auto colof = [&](int t) { return (Acol + t) % npcol; };
+        const int t0 = (myrow - Arow + nprow) % nprow,
+          u0 = (mycol - Acol + npcol) % npcol;
+        // local row offset (rel. to BC / A0 rows) of my block t, local col
+        // offset of my block column t
+        auto lrow = [&](int t) { return ((t - t0) / nprow) * nb; };
+        auto lcol = [&](int t) { return ((t - u0) / npcol) * nb; };
+        auto Aat = [&](int t, int u) {
+          return Abase + A0 + lrow(t) + std::ptrdiff_t(lcol(u)) * Ald; };
+        auto BRat = [&](int u) { return BR + std::ptrdiff_t(lcol(u)) * LDBR; };
+        auto BCat = [&](int t) { return BC + lrow(t); };
+        // the step at which block t is solved
+        auto stepof = [&](int t) { return upper_ ? nbl - 1 - t : t; };
+        auto key = [&](int i, int j) {
+          return std::make_pair(IA, (long long)i * nbl + j); };
+        // accumulated window of my pending diagonal block
+        std::vector<double> V, own, xr;
+        for (int q=0; q<nbl; q++) {
+          const int t = blk(q), r = rowof(t), c = colof(t), kb = kbs(t);
+          // (1) own partial sums of my column for the block of my row in
+          // the next Pc-1 steps, final now (their last update from this
+          // column was a finish update of an earlier step)
+          if (mycol == c)
+            for (int d=1; d<Pc && q+d<nbl; d++) {
+              int i = blk(q + d);
+              if (rowof(i) == myrow) {
+                isend(BCat(i), kbs(i), N, LDBC, g_.rank(myrow, colof(i)), tag_own);
+                break;
+              }
+            }
+          // (2) window update with the previous step's solution for my
+          // diagonal block, if it is in that window
+          if (q > 0)
+            for (int e=0; e<Pc-1 && q+e<nbl; e++) {
+              int i = blk(q + e);
+              if (rowof(i) != myrow || colof(i) != mycol) continue;
+              const int qp = q - 1, j = blk(qp), kbi = kbs(i), kbj = kbs(j);
+              xr.resize(std::size_t(N) * kbj);
+              // x_j comes from its owner for the next block, else forwarded
+              // by the process of my row in column colof(j)
+              recv(xr.data(), N, kbj, N, e == 0 ? g_.rank(rowof(j), colof(j))
+                   : g_.rank(myrow, colof(j)), tag_x2);
+              own.resize(std::size_t(kbi) * N);
+              recv(own.data(), kbi, N, kbi, g_.rank(myrow, colof(j)), tag_own);
+              const int ldv = LDBC;
+              if (qp == std::max(0, stepof(i) - Pc + 1)) {
+                V.resize(std::size_t(ldv) * (N - 1) + kbi);
+                for (int cc=0; cc<N; cc++)
+                  std::copy(own.data() + std::size_t(cc)*kbi, own.data() + std::size_t(cc+1)*kbi,
+                            V.data() + std::size_t(cc)*ldv);
+              } else add(kbi, N, own.data(), kbi, V.data(), ldv);
+              auto& L = cache_->L[key(i, j)];
+              const int ldl = Ald;
+              blas::gemm('N', 'T', kbi, N, kbj, -1., L.data(), ldl, xr.data(), N,
+                         1., V.data(), ldv);
+              break;
+            }
+          // (3) diagonal block
+          if (myrow == r && mycol == c) {
+            if (q > 0) add(kb, N, V.data(), LDBC, BCat(t), LDBC);
+            blas::trsm('L', uplo, 'N', diag, kb, N, 1., Aat(t, t), Ald, BCat(t), LDBC);
+            tadd(kb, N, BCat(t), LDBC, BRat(t), LDBR);
+            const double* x = BRat(t);
+            if (q + 1 < nbl) {
+              int i = blk(q + 1);
+              isend(x, N, kb, LDBR, g_.rank(rowof(i), colof(i)), tag_x2);
+            }
+            bsend(N, kb, x, LDBR);
+            note_solved(c, BCat(t), kb, N, LDBC, 0);
+          } else if (mycol == c) {
+            brecv(N, kb, BRat(t), LDBR, r);
+            // forward to the owner of the block of my row in the window
+            for (int d=2; d<Pc && q+d<nbl; d++) {
+              int i = blk(q + d);
+              if (rowof(i) == myrow) {
+                isend(BRat(t), N, kb, LDBR, g_.rank(myrow, colof(i)), tag_x2);
+                break;
+              }
+            }
+          } else if (myrow == r)
+            zero(kb, N, BCat(t), LDBC);
+          // (4) finish update with the previous step's solution
+          if (q > 0 && mycol == colof(blk(q-1)) && Anp > 0) {
+            const int j = blk(q-1), kbj = kbs(j);
+            int off = -1, Mf = 0;
+            if (!upper_) {
+              // my blocks t' >= j + Pc
+              int tf = j + Pc;
+              if (tf < nbl) {
+                int rem = (tf - t0) % nprow; if (rem < 0) rem += nprow;
+                if (rem) tf += nprow - rem;
+                if (tf < nbl) { off = lrow(tf); Mf = Anp - off; }
+              }
+            } else {
+              // my blocks t' <= j - Pc
+              int tl = j - Pc;
+              if (tl >= 0) {
+                int rem = (tl - t0) % nprow; if (rem < 0) rem += nprow;
+                tl -= rem;
+                if (tl >= 0) { off = 0; Mf = lrow(tl) + kbs(tl); }
+              }
+            }
+            if (Mf > 0)
+              blas::gemm('N', 'T', Mf, N, kbj, -1.,
+                         Abase + A0 + off + std::ptrdiff_t(lcol(j)) * Ald, Ald,
+                         BRat(j), LDBR, 1., BC + off, LDBC);
+          }
+        }
+      }
+
+      // copies of A(i, j) for the window chains of all logical blocks, built
+      // by all processes of the grid (once per factorization)
+      void build_lcache(int An, int nb, const double* A, int lda) {
+        const int nprow = g_.nprow, npcol = g_.npcol,
+          myrow = g_.myrow, mycol = g_.mycol, Pc = npcol;
+        if (!(nprow > 1 && npcol > 1 && npcol <= nprow)) return;
+        const int Alcmb = 2 * pblas_nb * lcm(nprow, npcol);
+        const int Aimb1 = firstnb(An, 0, nb, nb);
+        if (Aimb1 != nb) return;
+        Desc d{Aimb1, Aimb1, nb, nb, 0, 0, lda};
+        for (int k=0; k<An; k+=Alcmb) {
+          const int M = std::min(An - k, Alcmb), nbl = (M + nb - 1) / nb;
+          int Aii, Ajj, Arow, Acol;
+          g2l1(k, d.imb, d.mb, d.rsrc, nprow, myrow, Aii, Arow);
+          g2l1(k, d.inb, d.nb, d.csrc, npcol, mycol, Ajj, Acol);
+          if (!span(M, 0, nb, nb, Arow, nprow) || !span(M, 0, nb, nb, Acol, npcol))
+            continue;
+          auto blk = [&](int q) { return upper_ ? nbl - 1 - q : q; };
+          auto stepof = [&](int t) { return upper_ ? nbl - 1 - t : t; };
+          auto kbs = [&](int t) { return std::min(nb, M - t * nb); };
+          auto rowof = [&](int t) { return (Arow + t) % nprow; };
+          auto colof = [&](int t) { return (Acol + t) % npcol; };
+          const int t0 = (myrow - Arow + nprow) % nprow,
+            u0 = (mycol - Acol + npcol) % npcol;
+          auto lrow = [&](int t) { return ((t - t0) / nprow) * nb; };
+          auto lcol = [&](int t) { return ((t - u0) / npcol) * nb; };
+          const std::ptrdiff_t A0 = Aii + std::ptrdiff_t(Ajj) * lda;
+          for (int u=u0; u<nbl; u+=npcol) {
+            int qj = stepof(u);
+            for (int dd=1; dd<Pc && qj+dd<nbl; dd++) {
+              int i = blk(qj + dd);
+              if (rowof(i) != myrow) continue;
+              isend(A + A0 + lrow(i) + std::ptrdiff_t(lcol(u)) * lda, kbs(i),
+                    kbs(u), lda, g_.rank(myrow, colof(i)), tag_l);
+            }
+          }
+          for (int t=t0; t<nbl; t+=nprow)
+            if (colof(t) == mycol) {
+              int q = stepof(t);
+              for (int qq=std::max(0, q-Pc+1); qq<q; qq++) {
+                int j = blk(qq);
+                auto& L = cache_->L[std::make_pair(k, (long long)t * nbl + j)];
+                L.resize(std::size_t(lda) * (kbs(j) - 1) + kbs(t));
+                recv(L.data(), kbs(t), kbs(j), lda,
+                     g_.rank(myrow, colof(j)), tag_l);
+              }
+            }
+          wait_all();
+        }
+      }
+
+      // a solved diagonal block in a process column other than 0 is sent to
+      // process column 0 (replaces the final combine)
+      void note_solved(int col, const double* x, int kb, int Nb, int ld, int) {
+        if (wbc_sum_ && col != 0) isend(x, kb, Nb, ld, g_.rank(g_.myrow, 0), tag_x);
+      }
+    };
+
+  } // end namespace trsmnarrow
+} // end namespace strumpack
