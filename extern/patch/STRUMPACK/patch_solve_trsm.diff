+                  isend(BC + Bprev, n1pprev, Nb, LDBC, g_.rank(myrow, Acol), tag_win);
+                else if (mycol == Acol) {
+                  recv(work.data(), n1pprev, Nb, n1pprev, g_.rank(myrow, rocprev), tag_win);
