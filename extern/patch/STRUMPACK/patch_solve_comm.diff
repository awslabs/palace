+      (sval.data(), const_cast<int*>(sp.scnts.data()),
+       const_cast<int*>(sp.sdispls.data()), rval.data(),
+       const_cast<int*>(sp.rcnts.data()), const_cast<int*>(sp.rdispls.data()));
+
+    DenseM_t xloc(local_range_.second - local_range_.first, n);
