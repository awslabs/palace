+#ifndef METIS_TREE_REORDERING_HPP
+#define METIS_TREE_REORDERING_HPP
+
+#include <algorithm>
+#include <cstdint>
+#include <functional>
+#include <iostream>
+#include <numeric>
+#include <utility>
+#include <vector>
+#include "metis.h"
+
+#include "sparse/CSRMatrixMPI.hpp"
+#include "sparse/SeparatorTree.hpp"
+
+/*
+ * Nested dissection with METIS (not ParMETIS) that is parallel over
+ * the separator tree, ReorderingStrategy::METIS_TREE.
+ *
+ * The graph is gathered on process 0, as for the METIS ordering.
+ * Process 0 computes the top vertex separator as METIS_NodeND does
+ * (see metis_tree_separator), keeps one part and sends the other part
+ * to the process in the middle of its range of processes. Both
+ * continue in the same way with their part and their half of the
+ * range. A process whose range is down to itself orders its subgraph
+ * with METIS_NodeND. So only the top separator is computed while all
+ * other processes wait.
+ *
+ * The result is a distributed separator tree with one leaf per
+ * process (leaf k on process k), where the rows of a separator come
+ * after those of its two subtrees: the layout of the ParMETIS and
+ * PT-Scotch orderings. The range of processes is split in the middle
+ * whatever its size, so the number of processes does not need to be a
+ * power of two. The two parts of a separator have about the same
+ * size, so the leaves do not if the number of processes is not a
+ * power of two, as is the case with the METIS ordering.
+ *
+ * Every message goes from the first process of a range to a process
+ * that waits for exactly this message, and METIS is deterministic, so
+ * the ordering only depends on the gathered graph, with the order of
+ * the neighbours of its rows, and on the number of leaves.
+ *
+ * Every process then sends the rows it numbered to process 0, the
+ * only process that gets the permutation: no other process needs an
+ * array of the size of the matrix here.
+ */
+namespace strumpack {
+
+  /**
+   * Number of leaves of the distributed separator tree of the
+   * METIS_TREE ordering of n rows on P processes: one per process,
+   * but fewer for a small matrix, to keep about 2000 rows or more
+   * per leaf (a heuristic). With one leaf, use the METIS ordering.
+   */
+  template<typename integer_t> int metis_tree_leaves(integer_t n, int P) {
+    const integer_t min_rows_per_leaf = 2000;
+    return std::max(integer_t(1),
+                    std::min(integer_t(P), n / min_rows_per_leaf));
+  }
+
+  /**
+   * Vertex separator of the graph (xadj, adj) from METIS: part[i]
+   * becomes 0 or 1 for a vertex of one of the two parts and 2 for a
+   * vertex of the separator. Returns the METIS error code.
+   *
+   * This is what METIS_NodeND does at its top level (libmetis/ometis.c,
+   * with CompressGraph of libmetis/compress.c). Vertices with the same
+   * neighbours, themselves included, are merged into one vertex with
+   * their number as weight, if this removes more than 15% of the
+   * vertices, and METIS computes two separators and keeps the best if
+   * it removes more than a third. Then the bisection of METIS_NodeND,
+   * METIS_ComputeVertexSeparator, is called on the smaller graph, so
+   * merged vertices are on the same side of the separator. For a
+   * matrix with several unknowns per mesh node this makes the
+   * separator cheaper, in time and in memory. METIS_NodeND compresses
+   * once, the whole graph; here every subgraph is tried while the
+   * previous attempt paid off: compress says whether to try, and is
+   * reset when nothing is gained.
+   */
+  inline int metis_tree_separator(std::vector<idx_t>& xadj,
+                                  std::vector<idx_t>& adj, idx_t* options,
+                                  bool& compress, std::vector<idx_t>& part) {
+    idx_t nv = part.size(), sep = 0;
+    if (compress) {
+      // sort by a key that is the same for the same set of neighbours
+      std::vector<std::pair<std::size_t,idx_t>> key(nv);
+      for (idx_t i=0; i<nv; i++) {
+        std::size_t k = i;
+        for (idx_t j=xadj[i]; j<xadj[i+1]; j++) k += adj[j];
+        key[i] = {k, i};
+      }
+      std::sort(key.begin(), key.end());
+      // cmap[i] is the merged vertex of i, vertex[c] one vertex of c
+      std::vector<idx_t> cmap(nv, -1), mark(nv, -1), vertex, cweight;
+      for (idx_t a=0; a<nv; a++) {
+        const idx_t i = key[a].second, degree = xadj[i+1] - xadj[i];
+        if (cmap[i] != -1) continue;
+        cmap[i] = vertex.size();
+        vertex.push_back(i);
+        cweight.push_back(1);
+        // only a vertex with the same key can have the same neighbours
+        if (a+1 == nv || key[a+1].first != key[a].first) continue;
+        mark[i] = a;
+        for (idx_t j=xadj[i]; j<xadj[i+1]; j++) mark[adj[j]] = a;
+        for (idx_t b=a+1; b<nv && key[b].first==key[a].first; b++) {
+          const idx_t t = key[b].second;
+          if (cmap[t] != -1 || mark[t] != a || xadj[t+1]-xadj[t] != degree)
+            continue;
+          idx_t j = xadj[t];
+          while (j < xadj[t+1] && mark[adj[j]] == a) j++;
+          if (j == xadj[t+1]) {
+            cmap[t] = cmap[i];
+            cweight.back()++;
+          }
+        }
+      }
+      idx_t cnv = vertex.size();
+      if (cnv < 0.85 * nv) {
+        std::vector<idx_t> cxadj(1, 0), cadj, cpart(cnv);
+        std::fill(mark.begin(), mark.end(), -1);
+        for (idx_t c=0; c<cnv; c++) {
+          mark[c] = c;
+          for (idx_t j=xadj[vertex[c]]; j<xadj[vertex[c]+1]; j++) {
+            const idx_t d = cmap[adj[j]];
+            if (mark[d] != c) {
+              mark[d] = c;
+              cadj.push_back(d);
+            }
+          }
+          cxadj.push_back(cadj.size());
+        }
+        idx_t coptions[METIS_NOPTIONS];
+        std::copy(options, options+METIS_NOPTIONS, coptions);
+        if (nv > 1.5 * cnv) coptions[METIS_OPTION_NSEPS] = 2;
+        int ierr = METIS_ComputeVertexSeparator
+          (&cnv, cxadj.data(), cadj.data(), cweight.data(), coptions, &sep,
+           cpart.data());
+        for (idx_t i=0; i<nv; i++) part[i] = cpart[cmap[i]];
+        return ierr;
+      }
+      compress = false;
+    }
+    return METIS_ComputeVertexSeparator
+      (&nv, xadj.data(), adj.data(), nullptr, options, &sep, part.data());
+  }
+
+  /**
+   * A subgraph in the recursion: vertex i is row rows[i] of the
+   * matrix, xadj and adj are its adjacency structure without the
+   * diagonal, in the numbering of the subgraph. compress: see
+   * metis_tree_separator. The graph comes from gather_graph, so
+   * every array fits in one MPI message.
+   */
+  template<typename integer_t> struct MetisTreeGraph {
+    std::vector<idx_t> xadj, adj;
+    std::vector<integer_t> rows;
+    bool compress = true;
+
+    void send(int dest, const MPIComm& comm) const {
+      comm.send(std::vector<int>{compress}, dest, 0);
+      comm.send(rows, dest, 0);
+      comm.send(xadj, dest, 0);
+      comm.send(adj, dest, 0);
+    }
+
+    void recv(int src, const MPIComm& comm) {
+      compress = comm.recv<int>(src, 0)[0];
+      rows = comm.recv<integer_t>(src, 0);
+      xadj = comm.recv<idx_t>(src, 0);
+      adj = comm.recv<idx_t>(src, 0);
+    }
+
+    /**
+     * Split this graph with a vertex separator. The rows
+     * of the separator are appended to ordered, in their new order,
+     * part 0 stays in this graph, and part 1 is returned in other.
+     * Any of the three can be empty. Returns the METIS error code; on
+     * an error nothing is split off.
+     */
+    int split(idx_t* options, std::vector<integer_t>& ordered,
+              MetisTreeGraph<integer_t>& other, integer_t& separator_size) {
+      idx_t nv = rows.size();
+      std::vector<idx_t> part(nv);
+      int ierr = METIS_OK;
+      if (nv > 1)
+        ierr = metis_tree_separator(xadj, adj, options, compress, part);
+      if (ierr != METIS_OK) std::fill(part.begin(), part.end(), 0);
+      // number of each vertex in its part (0, 1, or 2: the separator),
+      // and the edges of the vertices of each part
+      idx_t size[3] = {0, 0, 0};
+      std::size_t edges[3] = {0, 0, 0};
+      std::vector<idx_t> local(nv);
+      for (idx_t i=0; i<nv; i++) {
+        local[i] = size[part[i]]++;
+        edges[part[i]] += xadj[i+1] - xadj[i];
+      }
+      // Number the rows of the separator in the order of a fixed mix
+      // of their row number, not in the order of the matrix. The
+      // latter is the numbering of the application, in which
+      // neighbouring unknowns can be nearly dependent: the LU
+      // factorization of the front of the separator eliminates its
+      // columns in this order (partial pivoting only exchanges rows)
+      // and then meets small pivots early. METIS_NodeND numbers the
+      // vertices of a separator in the order of its boundary list
+      // (MlevelNestedDissection in libmetis/ometis.c), which the moves
+      // of the separator refinement have rearranged, but
+      // METIS_ComputeVertexSeparator does not return that list. The
+      // mix (the finalizer of SplitMix64) is a bijection of the 64-bit
+      // integers, so the keys are distinct and the order only depends
+      // on the row numbers, on every platform; the result of
+      // std::shuffle depends on the standard library. The fill does
+      // not depend on this order.
+      std::vector<std::pair<std::uint64_t,idx_t>> key;
+      key.reserve(size[2]);
+      for (idx_t i=0; i<nv; i++)
+        if (part[i] == 2) {
+          std::uint64_t z = std::uint64_t(rows[i]) + 0x9e3779b97f4a7c15;
+          z = (z ^ (z >> 30)) * 0xbf58476d1ce4e5b9;
+          z = (z ^ (z >> 27)) * 0x94d049bb133111eb;
+          key.emplace_back(z ^ (z >> 31), i);
+        }
+      std::sort(key.begin(), key.end());
+      for (auto& k : key) ordered.push_back(rows[k.second]);
+      MetisTreeGraph<integer_t> half[2];
+      for (int s=0; s<2; s++) {
+        half[s].rows.reserve(size[s]);
+        half[s].xadj.reserve(size[s]+1);
+        half[s].xadj.push_back(0);
+        half[s].adj.reserve(edges[s]); // those to the separator are dropped
+      }
+      for (idx_t i=0; i<nv; i++) {
+        const auto s = part[i];
+        if (s == 2) continue;
+        for (idx_t k=xadj[i]; k<xadj[i+1]; k++)
+          if (part[adj[k]] == s) half[s].adj.push_back(local[adj[k]]);
+        half[s].xadj.push_back(half[s].adj.size());
+        half[s].rows.push_back(rows[i]);
+      }
+      half[0].compress = half[1].compress = compress;
+      separator_size = size[2];
+      *this = std::move(half[0]);
+      other = std::move(half[1]);
+      return ierr;
+    }
+
+    /**
+     * Order this graph with METIS_NodeND and append its rows to
+     * ordered, in their new order. Returns the METIS error code.
+     */
+    int order(idx_t* options, std::vector<integer_t>& ordered) {
+      idx_t nv = rows.size();
+      if (!nv) return METIS_OK;
+      // vertex[k] is the vertex in place k of the ordering of METIS
+      std::vector<idx_t> vertex(nv), position(nv);
+      int ierr = METIS_NodeND
+        (&nv, xadj.data(), adj.data(), nullptr, options,
+         vertex.data(), position.data());
+      if (ierr == METIS_OK)
+        for (idx_t k=0; k<nv; k++) ordered.push_back(rows[vertex[k]]);
+      return ierr;
+    }
+  };
+
+  /**
+   * Nested dissection with METIS, parallel over a separator tree
+   * with the given number of leaves, at most the number of
+   * processes: see the top of this file.
+   *
+   * \param perm of the size of the matrix on process 0, where on
+   * output perm[i] is the position of row i in the new ordering; not
+   * used on the other processes
+   * \param tree on output, on every process, the distributed
+   * separator tree: leaf k is the subgraph of process k
+   * \return 0, or the error code of METIS (on every process)
+   */
+  template<typename scalar_t,typename integer_t> int
+  metis_tree_nested_dissection(const CSRMatrixMPI<scalar_t,integer_t>& A,
+                               const MPIComm& comm, int leaves,
+                               std::vector<integer_t>& perm,
+                               SeparatorTree<integer_t>& tree) {
+    const int rank = comm.rank();
+    const integer_t n = A.size();
+    MetisTreeGraph<integer_t> g;
+    if (auto Aseq = A.gather_graph()) { // only root
+      g.xadj.reserve(n+1);
+      g.adj.reserve(Aseq->edges());
+      g.xadj.push_back(0);
+      for (integer_t i=0; i<n; i++) { // remove diagonal elements
+        for (integer_t k=Aseq->ptr(i); k<Aseq->ptr(i+1); k++)
+          if (Aseq->ind(k) != i) g.adj.push_back(Aseq->ind(k));
+        g.xadj.push_back(g.adj.size());
+      }
+      g.rows.resize(n);
+      std::iota(g.rows.begin(), g.rows.end(), integer_t(0));
+    } // the gathered graph is freed here, before the first separator
+    // The nodes of the separator tree are numbered in postorder, so a
+    // subtree with k leaves is 2k-1 consecutive nodes ending with its
+    // root, and its first k/2 leaves are the first subtree of the root.
+    std::vector<integer_t> sizes(2*leaves-1);
+    // the nodes whose rows this process numbers, and these rows, node
+    // by node in their new order
+    std::vector<int> nodes;
+    std::vector<integer_t> ordered;
+    int ierr = METIS_OK;
+    if (rank < leaves) {
+      idx_t options[METIS_NOPTIONS];
+      METIS_SetDefaultOptions(options);
+      // process p0 holds the subgraph of the processes [p0,p1), whose
+      // subtree starts with node
+      int p0 = 0, p1 = leaves, node = 0;
+      while (p1 - p0 > 1) {
+        const int pm = p0 + (p1 - p0) / 2;
+        if (rank == p0) {
+          MetisTreeGraph<integer_t> other;
+          nodes.push_back(node + 2*(p1-p0) - 2);
+          int e = g.split(options, ordered, other, sizes[nodes.back()]);
+          if (e != METIS_OK) ierr = e;
+          other.send(pm, comm);
+        } else if (rank == pm) g.recv(p0, comm);
+        if (rank < pm) p1 = pm;
+        else {
+          node += 2*(pm-p0) - 1;
+          p0 = pm;
+        }
+      }
+      nodes.push_back(node);
+      int e = g.order(options, ordered);
+      if (e != METIS_OK) ierr = e;
+      sizes[node] = g.rows.size();
+      g = MetisTreeGraph<integer_t>();
+    }
+    // METIS_OK is 1 and the METIS error codes are negative
+    ierr = comm.all_reduce(ierr, MPI_MIN);
+    if (ierr != METIS_OK) {
+      if (comm.is_root())
+        std::cerr << "# ERROR: Metis nested dissection reordering failed"
+                  << " with error code " << ierr << std::endl;
+      return ierr;
+    }
+    comm.all_reduce(sizes, MPI_SUM);
+    tree = SeparatorTree<integer_t>(sizes.size());
+    tree.sizes[0] = 0;
+    for (std::size_t i=0; i<sizes.size(); i++)
+      tree.sizes[i+1] = tree.sizes[i] + sizes[i];
+    // process 0 gets the rows of every node from the process that
+    // numbered them: they take the positions of the node, in order
+    if (rank && rank < leaves) {
+      comm.send(nodes, 0, 0);
+      comm.send(ordered, 0, 0);
+    }
+    for (int p=0; !rank && p<leaves; p++) {
+      if (p) {
+        nodes = comm.recv<int>(p, 0);
+        ordered = comm.recv<integer_t>(p, 0);
+      }
+      auto row = ordered.begin();
+      for (auto node : nodes)
+        for (auto i=tree.sizes[node]; i<tree.sizes[node+1]; i++)
+          perm[*row++] = i;
+    }
+    // set the children of the root of the subtree with k leaves that
+    // starts with node first, and return this root
+    std::function<integer_t(integer_t,integer_t)> subtree =
+      [&](integer_t k, integer_t first) {
+        const integer_t root = first + 2*k - 2;
+        tree.lch[root] = tree.rch[root] = -1;
+        if (k > 1) {
+          tree.lch[root] = subtree(k/2, first);
+          tree.rch[root] = subtree(k-k/2, first+2*(k/2)-1);
+          tree.parent[tree.lch[root]] = tree.parent[tree.rch[root]] = root;
+        }
+        return root;
+      };
+    tree.parent[subtree(leaves, 0)] = -1;
+    return 0;
+  }
+
+} // end namespace strumpack
+
+#endif // METIS_TREE_REORDERING_HPP
