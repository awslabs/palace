{
  // Line-fed rectangular microstrip patch antenna of Sheen et al. (1990), with a
  // second-order absorbing boundary on the open faces of the box. The wave port mode is
  // solved with PEC on the edges of the port (the rest of the y = 0 face, attribute 6). S11
  // is de-embedded to 4 mm before the edge of the patch.
  "Problem": {
    "Type": "Driven",
    "Verbose": 2,
    "Output": "postpro/abc2",
    "OutputFormats": {
      "Paraview": false
    }
  },
  "Model": {
    "Mesh": "mesh/patch_antenna.msh",
    "L0": 1.0e-3
  },
  "Domains": {
    "Materials": [
      {
        "Attributes": [1],
        "Permeability": 1.0,
        "Permittivity": 2.2
      },
      {
        "Attributes": [2],
        "Permeability": 1.0,
        "Permittivity": 1.0
      }
    ]
  },
  "Boundaries": {
    "PEC": {
      "Attributes": [3, 4]
    },
    "WavePort": [
      {
        "Index": 1,
        "Attributes": [5],
        "Mode": 1,
        "Offset": 16.0,
        "Excitation": true
      }
    ],
    "WavePortPEC": {
      "Attributes": [6]
    },
    "Absorbing": {
      "Attributes": [6, 7],
      "Order": 2
    }
  },
  "Solver": {
    "Order": 2,
    "Device": "CPU",
    "Driven": {
      "MinFreq": 4.0,
      "MaxFreq": 20.0,
      "FreqStep": 0.02,
      "SaveStep": 0,
      "AdaptiveTol": 1.0e-2,
      "AdaptiveMaxSamples": 60
    },
    "Linear": {
      "Type": "Default",
      "KSPType": "GMRES",
      "Tol": 1.0e-8,
      "MaxIts": 200,
      // The box is two wavelengths across at 20 GHz, where the complex coarse solve needs
      // far fewer iterations
      "ComplexCoarseSolve": true,
      "EstimatorTol": 1.0e-2
    }
  }
}
