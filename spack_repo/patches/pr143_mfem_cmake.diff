+    @property
+    def cxxstd(self):
+        """Return the C++ standard to use, or None for the compiler default."""
+        spec = self.spec
+        cxxstd = None
+        if spec.satisfies("@4.0.0:"):
+            cxxstd = "11"
+        if spec.satisfies("^raja@2022.03.0:"):
+            cxxstd = "14"
