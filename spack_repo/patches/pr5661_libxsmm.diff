diff --git a/repos/spack_repo/builtin/packages/libxsmm/package.py b/repos/spack_repo/builtin/packages/libxsmm/package.py
index f07d7c97..aed13b6c 100644
--- a/repos/spack_repo/builtin/packages/libxsmm/package.py
+++ b/repos/spack_repo/builtin/packages/libxsmm/package.py
@@ -97,7 +97,12 @@ class Libxsmm(MakefilePackage):
     # A recent `as` is needed to compile libxmss until version 1.17
     # (<https://github.com/spack/spack/issues/28404>), but not afterwards
     # (<https://github.com/spack/spack/pull/21671#issuecomment-779882282>).
-    depends_on("binutils+ld+gas@2.33:", type="build")
+    # Only needed to build libxsmm < 1.17 (per the note above); scope it so
+    # newer versions build with the system assembler. On macOS binutils+gas+ld
+    # is unbuildable (recipe fails against the current SDK) and unavailable from
+    # Homebrew (no gas/ld), so an unconditional dep breaks builds that do not
+    # need it.
+    depends_on("binutils+ld+gas@2.33:", type="build", when="@:1.16")
 
     # Version 2.0 supports both x86_64 and aarch64
     requires("target=x86_64:", "target=aarch64:")
@@ -157,6 +162,15 @@ class Libxsmm(MakefilePackage):
         # always install libraries
         install_tree("lib", prefix.lib)
 
+        # macOS: the Makefile build bakes the build-tree path into each dylib's
+        # install name, so consumers record a spack-stage path that disappears
+        # after install and fail to load. Rewrite each id to its final path.
+        if spec.satisfies("platform=darwin +shared"):
+            from glob import glob as _glob
+            for lib in _glob(join_path(prefix.lib, "libxsmm*.dylib")):
+                if not os.path.islink(lib):
+                    which("install_name_tool")("-id", lib, lib)
+
         if spec.satisfies("+header-only"):
             install_tree("src", prefix.src)
 
