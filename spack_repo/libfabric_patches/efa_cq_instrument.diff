+#include <unistd.h>
+#include <errno.h>
+#include <time.h>
+
+/* DIAG (ofiwg/libfabric#12542): shm region lifecycle log, one file per
+ * process, timestamped so create/unlink events can be ordered across
+ * processes. */
+static void _smr_life_log(const char *fmt, ...)
+{
+	char path[64];
+	FILE *f;
+	va_list args;
+	struct timespec ts;
+
+	snprintf(path, sizeof(path), "/tmp/smr_life_%d.log", (int) getpid());
+	f = fopen(path, "a");
+	if (!f)
+		return;
+	clock_gettime(CLOCK_REALTIME, &ts);
+	fprintf(f, "[%lld.%06ld] ", (long long) ts.tv_sec, ts.tv_nsec / 1000);
+	va_start(args, fmt);
+	vfprintf(f, fmt, args);
+	va_end(args);
+	fclose(f);
+}
 
