+/* === EFA_SHM_DIAG instrumentation: connreq handshake tracking ===
+ * Counters per peer id, dumped to /tmp/smr_diag_<pid>.log on rare events.
+ * FI_SHM_CONNREQ_RETRY=1 enables the candidate fix: connreq resend when
+ * the handshake response hasn't arrived after a retry threshold. */
+static uint64_t _smr_verify_eagain[SMR_MAX_PEERS];
+static uint64_t _smr_sendname_full;
+static uint64_t _smr_sendname_sent[SMR_MAX_PEERS];
+static int _smr_connreq_retry = -1;
+
+static void _smr_diag_log(const char *fmt, ...)
+{
+	char path[64];
+	va_list args;
+	snprintf(path, sizeof(path), "/tmp/smr_diag_%d.log", getpid());
+	FILE *f = fopen(path, "a");
+	if (!f)
+		return;
+	va_start(args, fmt);
+	vfprintf(f, fmt, args);
+	va_end(args);
+	fclose(f);
+}
