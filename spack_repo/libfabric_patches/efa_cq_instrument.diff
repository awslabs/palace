 		return;
 
 	ret = smr_cmd_queue_next(smr_cmd_queue(peer_smr), &ce, &pos);
-	if (ret == -FI_ENOENT)
+	if (ret == -FI_ENOENT) {
+		/* DIAG: peer cmd queue full — connreq NOT sent. Without a
+		 * retry this would silently drop the handshake. */
+		_smr_sendname_full++;
+		_smr_diag_log("send_name: pid=%d peer=%ld CMD QUEUE FULL (count=%llu)\n",
+			      getpid(), (long) id,
+			      (unsigned long long) _smr_sendname_full);
 		return;
+	}
 
 	ce->ptr = smr_peer_to_peer(ep, peer_smr, id, (uintptr_t) &ce->cmd);
 	ce->cmd.hdr.op = SMR_OP_MAX + ofi_ctrl_connreq;
@@ -195,6 +229,10 @@ static void smr_send_name(struct smr_ep *ep, int64_t id)
 
 	smr_peer_data(ep->region)[id].name_sent = 1;
 	smr_cmd_queue_commit(ce, pos);
+	_smr_sendname_sent[id]++;
+	_smr_diag_log("send_name: pid=%d peer=%ld connreq COMMITTED (attempt %llu)\n",
+		      getpid(), (long) id,
+		      (unsigned long long) _smr_sendname_sent[id]);
 }
 
