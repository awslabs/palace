+static int _smr_life_on = -1;
+static int _smr_life_enabled(void) {
+	if (_smr_life_on < 0) { const char *v = getenv("FI_SHM_DIAG"); _smr_life_on = (v && v[0]=='1') ? 1 : 0; }
+	return _smr_life_on;
+}
+static void _smr_life(const char *fmt, ...) {
+	char path[64]; FILE *f; va_list ap; struct timespec ts;
+	if (!_smr_life_enabled()) return;
+	snprintf(path, sizeof(path), "/tmp/smr_dbg_%d.log", (int) getpid());
