@@ -202,6 +240,11 @@ int64_t smr_verify_peer(struct smr_ep *ep, fi_addr_t fi_addr)
 	int64_t id;
 	int ret;
 
+	if (_smr_connreq_retry < 0) {
+		const char *v = getenv("FI_SHM_CONNREQ_RETRY");
+		_smr_connreq_retry = (v && v[0] == '1') ? 1 : 0;
+	}
+
 	id = smr_addr_lookup(ep->util_ep.av, fi_addr);
 	assert(id < SMR_MAX_PEERS);
 	if (id < 0)
@@ -214,12 +257,43 @@ int64_t smr_verify_peer(struct smr_ep *ep, fi_addr_t fi_addr)
 		ofi_genlock_lock(&ep->util_ep.av->lock);
 		ret = smr_map_to_region(ep->map, id);
 		ofi_genlock_unlock(&ep->util_ep.av->lock);
-		if (ret)
+		if (ret) {
+			_smr_verify_eagain[id]++;
+			if (_smr_verify_eagain[id] == 1000000)
+				_smr_diag_log("verify_peer: pid=%d peer=%ld STUCK "
+					      "map_to_region failing (1M attempts, "
+					      "name_sent=%d peer_id=%d)\n",
+					      getpid(), (long) id,
+					      smr_peer_data(ep->region)[id].name_sent,
+					      (int) smr_peer_data(ep->region)[id].id);
 			return -1;
+		}
 	}
 
 	smr_send_name(ep, id);
 
+	_smr_verify_eagain[id]++;
+	if (_smr_verify_eagain[id] == 1000000) {
+		/* DIAG: 1M EAGAINs for one peer = permanently stuck handshake.
+		 * Dump the full handshake state. */
+		_smr_diag_log("verify_peer: pid=%d peer=%ld STUCK 1M attempts: "
+			      "name_sent=%d peer_id=%d region_mapped=%d\n",
+			      getpid(), (long) id,
+			      smr_peer_data(ep->region)[id].name_sent,
+			      (int) smr_peer_data(ep->region)[id].id,
+			      ep->map->peers[id].region != NULL);
+		if (_smr_connreq_retry) {
+			/* CANDIDATE FIX: clear name_sent so the connreq is
+			 * re-sent. If the original connreq (or its response)
+			 * was lost, this recovers the handshake. */
+			smr_peer_data(ep->region)[id].name_sent = 0;
+			_smr_verify_eagain[id] = 0;
+			_smr_diag_log("verify_peer: pid=%d peer=%ld RETRY: "
+				      "cleared name_sent, will resend connreq\n",
+				      getpid(), (long) id);
+		}
+	}
