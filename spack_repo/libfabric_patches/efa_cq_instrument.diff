diff --git a/prov/shm/src/smr_ep.c b/prov/shm/src/smr_ep.c
index 2e1c64a56..2ae904ff4 100644
--- a/prov/shm/src/smr_ep.c
+++ b/prov/shm/src/smr_ep.c
@@ -35,6 +35,53 @@
 #include "smr_signal.h"
 #include "ofi_mb.h"
 
+#include <stdio.h>
+#include <stdarg.h>
+#include <unistd.h>
+#include <errno.h>
+#include <time.h>
+/* DIAG(#12542): global site of the last smr_map_to_region failure.
+ * 0=ok 1=shm_open 2=stat 3=st_size 4=mmap 5=!peer->pid. Set in smr_av.c;
+ * the av->lock serializes map_to_region so a plain global is safe. */
+extern int _smr_dbg_map_site;
+/* DIAG(#12542) build marker (assert its presence in the shipped .so).
+ * static + used so each TU keeps its own copy (no multiple-definition at link)
+ * while the literal still lands in .rodata for `strings` verification. */
+static char _smr_dbg_build_marker[] __attribute__((used)) = "SMR_DIAG_12542_BUILD_MARKER_v1";
+/* Env gate: FI_SHM_DIAG=1 turns logging on. Cached; -1 = uninitialized. */
+static int _smr_dbg_on = -1;
+static int _smr_dbg_enabled(void)
+{
+	if (_smr_dbg_on < 0) {
+		const char *v = getenv("FI_SHM_DIAG");
+		_smr_dbg_on = (v && v[0] == '1') ? 1 : 0;
+	}
+	return _smr_dbg_on;
+}
+static void _smr_dbg(const char *fmt, ...)
+{
+	char path[64];
+	FILE *f;
+	va_list ap;
+	struct timespec ts;
+	if (!_smr_dbg_enabled())
+		return;
+	snprintf(path, sizeof(path), "/tmp/smr_dbg_%d.log", (int) getpid());
+	f = fopen(path, "a");
+	if (!f)
+		return;
+	clock_gettime(CLOCK_REALTIME, &ts);
+	fprintf(f, "[%lld.%06ld] ", (long long) ts.tv_sec, ts.tv_nsec / 1000);
+	va_start(ap, fmt);
+	vfprintf(f, fmt, ap);
+	va_end(ap);
+	fclose(f);
+}
+
+/* DIAG(#12542): per-peer count of verify_peer() EAGAIN spins; dump once at threshold. */
+static uint64_t _smr_eagain[SMR_MAX_PEERS];
+static int _smr_connreq_retry = -1;
+
 extern struct fi_ops_msg smr_msg_ops, smr_no_recv_msg_ops;
 extern struct fi_ops_tagged smr_tag_ops, smr_no_recv_tag_ops;
 extern struct fi_ops_rma smr_rma_ops;
@@ -210,16 +257,54 @@ int64_t smr_verify_peer(struct smr_ep *ep, fi_addr_t fi_addr)
 	if (smr_peer_data(ep->region)[id].id >= 0)
 		return id;
 
+	if (_smr_connreq_retry < 0) {
+		const char *v = getenv("FI_SHM_CONNREQ_RETRY");
+		_smr_connreq_retry = (v && v[0] == '1') ? 1 : 0;
+	}
+
 	if (!ep->map->peers[id].region) {
 		ofi_genlock_lock(&ep->util_ep.av->lock);
+		_smr_dbg_map_site = 0;
 		ret = smr_map_to_region(ep->map, id);
 		ofi_genlock_unlock(&ep->util_ep.av->lock);
-		if (ret)
+		if (ret) {
+			/* SENDER-side map fail: this is SELF-HEALING (retried
+			 * every cycle). Record but do not treat as fatal. */
+			if (++_smr_eagain[id] == 1000000)
+				_smr_dbg("verify_peer: pid=%d STUCK-on-map self=%s "
+					 "peer_id=%ld peer_name=%s map_site=%d "
+					 "(sender-side map, self-healing)\n",
+					 (int) getpid(), ep->name, (long) id,
+					 ep->map->peers[id].name,
+					 _smr_dbg_map_site);
 			return -1;
+		}
 	}
 
 	smr_send_name(ep, id);
 
+	/* SENDER waiting for the receiver to ack our connreq. peer_data.id<0
+	 * means no ack yet. Dump full row ONCE at the stuck threshold, keyed by
+	 * NAME so it can be matched to a receiver drop/accept. */
+	if (++_smr_eagain[id] == 1000000) {
+		_smr_dbg("verify_peer: pid=%d STUCK self=%s peer_id=%ld "
+			 "peer_name=%s name_sent=%d peer_data_id=%ld "
+			 "region_mapped=%d\n",
+			 (int) getpid(), ep->name, (long) id,
+			 ep->map->peers[id].name,
+			 (int) smr_peer_data(ep->region)[id].name_sent,
+			 (long) smr_peer_data(ep->region)[id].id,
+			 ep->map->peers[id].region != NULL);
+		if (_smr_connreq_retry) {
+			/* CANDIDATE FIX (Exp 2): clear name_sent to force resend. */
+			smr_peer_data(ep->region)[id].name_sent = 0;
+			_smr_eagain[id] = 0;
+			_smr_dbg("verify_peer: pid=%d RETRY self=%s peer_name=%s "
+				 "cleared name_sent\n", (int) getpid(),
+				 ep->name, ep->map->peers[id].name);
+		}
+	}
+
 	return -1;
 }
 
