 				ep_name, entry) {
+		/* DIAG (ofiwg/libfabric#12542): record signal-time unlinks.
+		 * Not async-signal-safe, but acceptable for diagnosis. */
+		{
+			char _p[64];
+			FILE *_f;
+			snprintf(_p, sizeof(_p), "/tmp/smr_life_%d.log",
+				 (int) getpid());
+			_f = fopen(_p, "a");
+			if (_f) {
+				fprintf(_f, "SIGNAL_UNLINK pid=%d sig=%d "
+					"name=%s\n", (int) getpid(), signum,
+					ep_name->name);
+				fclose(_f);
+			}
+		}
 		shm_unlink(ep_name->name);
 	}
 	pthread_mutex_unlock(&ep_list_lock);
