+	va_start(ap, fmt); vfprintf(f, fmt, ap); va_end(ap);
+	/* backtrace: WHO called (esp. for smr_free) */
+	void *bt[20]; int nb = backtrace(bt, 20); char **sy = backtrace_symbols(bt, nb);
+	if (sy) { for (int i = 1; i < nb && i < 12; i++) fprintf(f, "    %s\n", sy[i]); free(sy); }
