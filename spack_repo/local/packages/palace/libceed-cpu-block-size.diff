diff --git a/backends/opt/ceed-opt.h b/backends/opt/ceed-opt.h
index a1b67a58..43d552ee 100644
--- a/backends/opt/ceed-opt.h
+++ b/backends/opt/ceed-opt.h
@@ -15,6 +15,16 @@ typedef struct {
   CeedInt block_size;
 } Ceed_Opt;
 
+// Element block size of an operator of the blocked backends: operators with many elements use larger blocks, which amortize the
+// per-block work (restrictions, QFunction calls) and widen the GEMMs of the basis contractions; the last block is padded, so
+// operators with few elements keep the blocks of the backend
+#define CEED_OPT_LARGE_BLOCK_SIZE 32
+#define CEED_OPT_LARGE_BLOCK_MIN_ELEMENTS 512
+
+static inline CeedInt CeedOptOperatorBlockSize(CeedInt block_size, CeedInt num_elem) {
+  return (block_size > 1 && num_elem >= CEED_OPT_LARGE_BLOCK_MIN_ELEMENTS) ? CEED_OPT_LARGE_BLOCK_SIZE : block_size;
+}
+
 typedef struct {
   CeedScalar *colo_grad_1d;
 } CeedBasis_Opt;
