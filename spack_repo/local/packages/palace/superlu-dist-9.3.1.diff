index 602c59b8..fc6dc0d4 100755
--- a/SRC/double/pdgstrs.c
+++ b/SRC/double/pdgstrs.c
@@ -421,6 +421,279 @@ dreadMM_dist_intoL_CSR(FILE *fp, int_t *m, int_t *n, int_t *nonz,
  * </pre>
