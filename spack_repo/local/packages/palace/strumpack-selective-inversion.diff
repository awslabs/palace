+    int ninv = 0;
+    double kmax_inv = 0., kmin_kept = std::numeric_limits<double>::infinity(),
+      kmax = 0.;
+    long long sep_inv = 0, sep_all = 0;
+    std::vector<int> dec(20, 0);
+    for (int f=0; f<nf; f++) {
+      const double* r = &all[6*f];
+      const double k = r[4];
+      kmax = std::max(kmax, k);
+      sep_all += (long long)r[2];
+      int d = std::isfinite(k) && k >= 1. ?
+        std::min(19, int(std::floor(std::log10(k)))) : 19;
+      dec[d]++;
