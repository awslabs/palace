+    MPI_Gather(&n, 1, MPI_INT, cnt.data(), 1, MPI_INT, 0, c.comm());
+    for (int p=0; p<P; p++) dsp[p+1] = dsp[p] + cnt[p];
+    std::vector<double> all(c.is_root() ? dsp[P] : 0);
+    MPI_Gatherv(si_records.data(), n, MPI_DOUBLE, all.data(), cnt.data(),
+                dsp.data(), MPI_DOUBLE, 0, c.comm());
