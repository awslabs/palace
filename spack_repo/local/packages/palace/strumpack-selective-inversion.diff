+      else kmin_kept = std::min(kmin_kept, k);
+    }
+    std::cout << "# STRUMPACK selective inversion: " << ninv << " of " << nf
+              << " distributed fronts inverted (" << sep_inv << " of " << sep_all
+              << " separator rows), kappa_1 max " << kmax << ", threshold "
+              << si_max_cond<typename RealType<scalar_t>::value_type>()
+              << ", max inverted " << kmax_inv
+              << ", min kept " << kmin_kept << std::endl;
+    std::cout << "#   kappa_1 by decade (1e0..):";
+    for (int d=0; d<20; d++) std::cout << " " << dec[d];
+    std::cout << std::endl;
+    int shown = 0;
+    for (int f=0; f<nf && shown < 12; f++) {
+      const double* r = &all[6*f];
