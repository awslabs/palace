+void ParaViewDataCollection::RegisterPointField(
+   const std::string &field_name, int vdim, int size,
+   std::function<void(Vector &)> evaluator)
+{
+   MFEM_VERIFY(vdim > 0 && size >= 0 && evaluator,
+               "Invalid ParaView point field registration!");
+   point_field_map[field_name] = {vdim, size, std::move(evaluator)};
+}
+
+void ParaViewDataCollection::SavePointFieldVTU(
+   std::ostream &os, int ref, const std::string &name,
+   const PointField &field, Vector &values)
+{
+   MFEM_VERIFY(!bdr_output,
+               "Direct point field output is not supported for "
+               "ParaViewDataCollection on domain boundary!");
+   int num_points = 0;
+   for (int i = 0; i < mesh->GetNE(); i++)
+   {
+      num_points += GlobGeometryRefiner.Refine(
+                       mesh->GetElementBaseGeometry(i), ref, 1)->RefPts.GetNPoints();
+   }
+   MFEM_VERIFY(field.size == num_points * field.vdim,
+               "Invalid direct point field size for \"" << name << "\": expected "
+               << num_points * field.vdim << ", got " << field.size);
+
+   values.SetSize(field.size);
+   field.evaluator(values);
+   MFEM_VERIFY(values.Size() == field.size,
+               "Direct point field evaluator changed the registered field size!");
+
+   os << "<DataArray type=\"" << GetDataTypeString()
+      << "\" Name=\"" << name
+      << "\" NumberOfComponents=\"" << field.vdim << "\" "
+      << VTKComponentLabels(field.vdim) << " "
+      << "format=\"" << GetDataFormatString() << "\" >" << '\n';
+   std::vector<char> buf;
+   const real_t *data = values.HostRead();
+   for (int i = 0; i < values.Size(); i++)
+   {
+      WriteBinaryOrASCII(os, buf, data[i],
+                         ((i + 1) % field.vdim) ? " " : "\n", pv_data_format);
+   }
+   if (pv_data_format != VTKFormat::ASCII)
+   {
+      WriteBase64WithSizeAndClear(os, buf, GetCompressionLevel());
+   }
+   os << "</DataArray>" << std::endl;
+}
