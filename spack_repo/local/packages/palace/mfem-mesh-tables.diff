+/** @brief Symmetric 3D Table storing the unique triplets of row, column, and
+    floor. The number of an entry is assigned by counting the entries from zero
+    as they are pushed into the table. Diagonals of any kind are not allowed so
+    the row, column and floor must all be different for each entry. Only one
+    entry is stored for all 6 symmetric entries that are indexable by unique
+    triplets of row, column, and floor. The entries are kept in an open
+    addressing hash table: the lookups of large tables, such as the faces of a
+    mesh with tens of millions of elements, take a few memory accesses instead
+    of a traversal of the entries of a row. */
 class STable3D
 {
 private:
    int Size, NElem;
-   STable3DNode **Rows;
 
-#ifdef MFEM_USE_MEMALLOC
-   MemAlloc <STable3DNode, 1024> NodesMem;
-#endif
+   /// Hash table slot; Row < 0 for an empty slot.
+   struct Slot { int Row, Column, Floor, Number; };
+   Slot *Slots;
+   int LogCapacity;
 
+   /// First slot to probe for the sorted triplet (r, c, f).
+   inline std::size_t Hash(int r, int c, int f) const
+   {
+      std::uint64_t k = (std::uint64_t(std::uint32_t(r)) << 32) | std::uint32_t(c);
+      k = (k ^ (std::uint64_t(std::uint32_t(f)) * 0xC2B2AE3D27D4EB4FULL)) *
+          0x9E3779B97F4A7C15ULL;
+      return std::size_t(k >> (64 - LogCapacity));
+   }
+
+   /// Slot of the sorted triplet (r, c, f), or the empty slot where it belongs.
+   inline Slot &Find(int r, int c, int f) const
+   {
+      const std::size_t mask = (std::size_t(1) << LogCapacity) - 1;
+      std::size_t i = Hash(r, c, f);
+      while (Slots[i].Row >= 0 &&
+             (Slots[i].Row != r || Slots[i].Column != c || Slots[i].Floor != f))
+      {
+         i = (i + 1) & mask;
+      }
+      return Slots[i];
+   }
+
+   /// Double the number of slots.
+   void Grow();
+
 public:
    /// Construct the table with a total of 'nr' rows.
    explicit STable3D (int nr);
