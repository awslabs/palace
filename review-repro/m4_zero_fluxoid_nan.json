      "Attributes": [2, 3, 4, 5, 6, 7]
    },
    "Superconductor":
    [
      {
        "Attributes": [8],
        "PenetrationDepth": 0.4,
        "Thickness": 0.1
      }
    ],
    "FluxLoop":
    [
      {
        "Index": 1,
        "FilmAttributes": [8],
        "HoleAttributes": [9],
        "FluxAmounts": [1.0],
