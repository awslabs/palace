# Spack checkout
spack

# Build artifacts
build*

# Documentation
docs

# Test data and results (keep test/unit/ for CMake build)
test/examples
examples/**/postpro*
examples/**/log*

# Singularity definitions
singularity
*.sif

# Editor and OS files
.*.swp
.DS_Store
.vscode/

# Git
# NOTE: .git is intentionally NOT ignored. The Palace build runs `git describe`
# to stamp the version (written to palace.json as "GitTag"); without .git it
# degrades to "UNKNOWN". The Dockerfile removes /opt/palace/.git in the same
# layer after the build so it never bloats the image.
.github

# Python caches
__pycache__
*.pyc

# Broken mfem symlink (recreated inside container by the template)
spack_repo/local/packages/mfem
