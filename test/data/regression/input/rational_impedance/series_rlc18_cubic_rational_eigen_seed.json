{
  "Problem":
  {
    "Type": "Eigenmode",
    "Verbose": 2,
    "Output": "postpro/series_rlc18_cubic_eigen_seed"
  },
  "Model":
  {
    "Mesh": "mesh/parallel_plate.msh",
    "L0": 1.0e-3  // mm
  },
  "Domains":
  {
    "Materials":
    [
      {
        "Attributes": [1],  // Vacuum fill
        "Permeability": 1.0,
        "Permittivity": 1.0,
        "LossTan": 0.0
      }
    ]
  },
  "Boundaries":
  {
    "PEC":
    {
      "Attributes": [2]  // Parallel plates (conductors)
    },
    "PMC":
    {
      "Attributes": [3]  // Side walls (magnetic walls -> clean TEM)
    },
    "RationalImpedance":
    [
      {
        "Attributes": [5],   // Termination under test (z = L)
        // The series RLC of series_rlc18_rational_eigen_seed.json (R = eta0, L = 2.0e-8
        // H/sq, C = 3.909e-15 F/sq, notch at 18 GHz) in parallel with an admittance
        // 1e-26 s^2 (not passive): Zs = N/D with N = s^2 LC + s RC + 1 and D = 1e-26 s^2 N +
        // s C. The Robin coefficient s D/N = 1e-26 s^3 + 1/L + R(s)/N(s) has a polynomial
        // part of degree 3, not exact in the seed, which freezes the whole coefficient at
        // the target here.
        "Numerator":   [7.817992564995199e-23, 1.4726373956323666e-12, 1.0],
        "Denominator": [7.817992564995199e-49, 1.4726373956323666e-38, 1.0e-26, 3.908996282497599e-15, 0.0]
      }
    ]
  },
  "Solver":
  {
    "Order": 2,
    "Device": "CPU",
    "Eigenmode":
    {
      "N": 1,
      "Target": 9.0,  // GHz
      "Tol": 1.0e-6,
      // The modes of the polynomial seed pencil, without the quasi-Newton refinement: with
      // the whole Robin coefficient frozen at the target the seed mode is ~9.6695 + 0.0004i
      // GHz, with only its pole part frozen ~9.6694 - 0.0035i GHz, and with the polynomial
      // interpolant of the whole coefficient ~9.24 + 0.32i GHz.
      "RefineNonlinear": false
    },
    "Linear":
    {
      "Type": "Default",
      "KSPType": "GMRES",
      "Tol": 1.0e-10,
      "MaxIts": 100,
      "ComplexCoarseSolve": true,
      "MGMaxLevels": 1
    }
  }
}
