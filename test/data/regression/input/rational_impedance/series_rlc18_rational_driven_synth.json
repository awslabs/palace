{
  "Problem":
  {
    "Type": "Driven",
    "Verbose": 2,
    "Output": "postpro/series_rlc18_driven_synth"
  },
  "Model":
  {
    "Mesh": "mesh/parallel_plate.msh",
    "L0": 1.0e-3  // mm
  },
  "Domains":
  {
    "Materials":
    [
      {
        "Attributes": [1],  // Vacuum fill
        "Permeability": 1.0,
        "Permittivity": 1.0,
        "LossTan": 0.0
      }
    ]
  },
  "Boundaries":
  {
    "PEC":
    {
      "Attributes": [2]  // Parallel plates (conductors)
    },
    "PMC":
    {
      "Attributes": [3]  // Side walls (magnetic walls -> clean TEM)
    },
    "LumpedPort":
    [
      {
        "Index": 1,
        "Attributes": [4],   // Source port (z = 0). Circuit synthesis requires a port;
        "R": 1.0e6,          // near-open R approximates the eigen config's PMC at this
        "Direction": "+Y",   // boundary so rom-eigenvalues.csv matches eig.csv.
        "Excitation": true
      }
    ],
    "RationalImpedance":
    [
      {
        "Attributes": [5],   // Termination under test (z = L)
        // Same series-RLC notch as series_rlc18_rational_eigen.json:
        // Zs = (s^2 LC + s RC + 1)/(sC) with R = eta0, L = 2.0e-8 H/sq,
        // C = 3.908996282497599e-15 F/sq, resonant at 18 GHz. The synthesized circuit
        // eigenvalues (rom-eigenvalues.csv) should match the nonlinear eigenmode results
        // (~9.60 + 0.045i and ~21.31 + 0.43i GHz).
        "Numerator":   [7.817992564995199e-23, 1.4726373956323666e-12, 1.0],
        "Denominator": [3.908996282497599e-15, 0.0]
      }
    ]
  },
  "Solver":
  {
    "Order": 2,
    "Device": "CPU",
    "Driven":
    {
      "Samples":
      [
        {
          "Type": "Linear",
          "MinFreq": 6.0,   // GHz
          "MaxFreq": 24.0,  // GHz (band covers both modes at ~9.6 and ~21.3 GHz)
          "FreqStep": 0.25  // GHz
        }
      ],
      "AdaptiveTol": 1.0e-6,
      "AdaptiveCircuitSynthesis": true
    },
    "Linear":
    {
      "Type": "Default",
      "KSPType": "GMRES",
      "Tol": 1.0e-8,
      "MaxIts": 100,
      "MGMaxLevels": 1,
      "ComplexCoarseSolve": true
    }
  }
}
