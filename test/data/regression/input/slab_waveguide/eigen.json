{
  "Problem":
  {
    "Type": "Eigenmode",
    "Verbose": 2,
    "Output": "postpro/eigen"
  },
  "Model":
  {
    "Mesh": "mesh/slab_waveguide.msh",
    "L0": 1.0e-2  // cm
  },
  "Domains":
  {
    "Materials":
    [
      {
        "Attributes": [1],  // dielectric slab (x in [0, 1] cm)
        "Permeability": 1.0,
        "Permittivity": 10.0,
        "LossTan": 0.0
      },
      {
        "Attributes": [2],  // air fill (x in [1, 2] cm)
        "Permeability": 1.0,
        "Permittivity": 1.0,
        "LossTan": 0.0
      }
    ]
  },
  "Boundaries":
  {
    "WavePort":
    [
      {
        // Hybrid/LSM mode (Mode 3) of a slab-loaded guide: the transverse
        // inhomogeneity makes the mode shape rotate with frequency, so the modal
        // correction W is genuinely rank>=2 and band-varying (vs rank-1 for a
        // homogeneous cross-section). Swept around a well-separated cavity resonance
        // so the synthesized pencil reproduces the eigenmode pole in Re{f} and Q.
        "Index": 1,
        "Attributes": [4],
        "Mode": 3,
        "KSPTol": 1e-8,
        "EigenTol": 1e-6
      }
    ],
    "PEC":
    {
      "Attributes": [3, 5]
    }
  },
  "Solver":
  {
    "Order": 2,
    "Device": "CPU",
    "Eigenmode":
    {
      "N": 2,
      "Tol": 1.0e-8,
      "LinearTol": 1.0e-4,
      "Target": 7.5,
      "TargetUpper": 8.2,
      "RefineNonlinear": true,
      "NonlinearType": "Hybrid",
      "Save": 0
    },
    "Linear":
    {
      "Type": "Default",
      "KSPType": "GMRES",
      "Tol": 1.0e-9,
      "MaxIts": 150
    }
  }
}
