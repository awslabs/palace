{
  "Problem":
  {
    "Type": "Eigenmode",
    "Verbose": 2,
    "Output": "postpro/wave_eigen"
  },
  "Model":
  {
    "Mesh": "mesh/slab_waveguide.msh",
    "L0": 1.0e-2  // cm
  },
  "Domains":
  {
    "Materials":
    [
      {
        "Attributes": [1],  // dielectric slab (x in [0, 1] cm)
        "Permeability": 1.0,
        "Permittivity": 10.0,
        "LossTan": 0.0
      },
      {
        "Attributes": [2],  // air fill (x in [1, 2] cm)
        "Permeability": 1.0,
        "Permittivity": 1.0,
        "LossTan": 0.0
      }
    ]
  },
  "Boundaries":
  {
    "WavePort":
    [
      {
        // Hybrid/LSM mode (Mode 3) of the slab-loaded guide: the transverse
        // inhomogeneity makes the mode shape rotate with frequency, so the wave-port
        // modal correction W is genuinely rank>=2 and band-varying. The eigenvalue
        // solve exercises W on the LHS: without W the computed Re{f}/Q shift, so this
        // is a genuine W-sensitivity regression.
        "Index": 1,
        "Attributes": [4],
        "Mode": 3,
        "KSPTol": 1e-8,
        "EigenTol": 1e-6
      }
    ],
    "PEC":
    {
      "Attributes": [3, 5]
    }
  },
  "Solver":
  {
    "Order": 4,
    "Device": "CPU",
    "Eigenmode":
    {
      "N": 1,
      "Tol": 1.0e-8,
      "Target": 7.3,  // GHz
      "Save": 0
    },
    "Linear":
    {
      "Type": "Default",
      "KSPType": "GMRES",
      "Tol": 1.0e-9,
      "MaxIts": 100
    }
  }
}
