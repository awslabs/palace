{
  "Problem":
  {
    "Type": "Eigenmode",
    "Verbose": 2,
    "Output": "postpro/driven_wave_tm_eigen"
  },
  "Model":
  {
    "Mesh": "mesh/cylinder_hex.msh",
    "L0": 1.0e-2  // cm
  },
  "Domains":
  {
    "Materials":
    [
      {
        // Lossless fill: the only loss (and hence the only imaginary part of the
        // eigenvalue) comes from radiation out the wave port.
        "Attributes": [1],
        "Permeability": 1.0,
        "Permittivity": 2.08,
        "LossTan": 0.0
      }
    ],
    "Postprocessing":
    {
      "Energy":
      [
        {
          "Index": 1,
          "Attributes": [1]
        }
      ]
    }
  },
  "Boundaries":
  {
    "WavePort":
    [
      {
        // TM01 (Mode 3) carries a longitudinal field E_z != 0 on the port face, so
        // the eigensolver's nonlinear (wave-port) contribution exercises the modal
        // correction W_full - W_scalar. Radiation through this port makes the
        // eigenvalue genuinely complex; the fix must not break NEP convergence.
        "Index": 1,
        "Attributes": [2],
        "Mode": 3,
        "KSPTol": 1e-8,
        "EigenTol": 1e-6
      }
    ],
    "PEC":
    {
      "Attributes": [3, 4]
    }
  },
  "Solver":
  {
    "Order": 4,
    "Device": "CPU",
    "Eigenmode":
    {
      "N": 2,
      "Tol": 1.0e-8,
      "Target": 3.4,  // GHz, near the driven TM01 excitation band
      "Save": 0
    },
    "Linear":
    {
      "Type": "Default",
      "KSPType": "GMRES",
      "Tol": 1.0e-9,
      "MaxIts": 100
    }
  }
}
