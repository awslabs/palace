      "MinFreq": 3.40,  // GHz
      "MaxFreq": 3.52,
      "FreqStep": 0.01,
      "AdaptiveTol": 1.0e-6,
      "AdaptiveCircuitSynthesis": true
    },
    "Linear":
    {
