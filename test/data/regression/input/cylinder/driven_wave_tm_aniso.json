{
  "Problem":
  {
    "Type": "Driven",
    "Verbose": 2,
    "Output": "postpro/driven_wave_tm_aniso"
  },
  "Model":
  {
    "Mesh": "mesh/cylinder_hex.msh",
    "L0": 1.0e-2  // cm
  },
  "Domains":
  {
    "Materials":
    [
      {
        // Uniaxial-anisotropic, lossless mu (transverse 1.5, longitudinal 1.0).
