        "Attributes": [1],
        "Permeability": [1.5, 1.5, 1.0],
        "Permittivity": 2.08,
        "LossTan": 0.0
      }
    ],
    "Postprocessing":
    {
      "Energy":
      [
        {
          "Index": 1,
          "Attributes": [1]
        }
      ]
    }
  },
  "Boundaries":
  {
    "WavePort":
    [
      {
        // TM01 (Mode 3): E_n != 0 on the port face; see driven_wave_tm.json.
        "Index": 1,
        "Attributes": [2],
        "Mode": 3,
        "Excitation": true,
        "KSPTol": 1e-8,
        "EigenTol": 1e-6
      }
    ],
    "PEC":
    {
      "Attributes": [3, 4]
    }
  },
  "Solver":
  {
    "Order": 4,
    "Device": "CPU",
    "Driven":
    {
      "MinFreq": 3.4,  // GHz
      "MaxFreq": 3.4,
      "FreqStep": 0.5,
      "SaveStep": 1
    },
    "Linear":
    {
      "Type": "Default",
      "KSPType": "GMRES",
      "Tol": 1.0e-9,
      "MaxIts": 100
    }
  }
}
