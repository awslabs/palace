#!/bin/bash

# Copyright Amazon.com, Inc. or its affiliates. All Rights Reserved.
# SPDX-License-Identifier: Apache-2.0

help()
{
    echo "Usage: validate-config [OPTIONS] CONFIG_FILE...

Validate the provided Palace configuration files against the provided JSON Schema

Options:
  -h, --help                       Show this help message and exit
  --julia COMMAND                  Executable command for julia
"
}

# Parse arguments
JULIA="julia"
POSITIONAL=()
while [[ $# -gt 0 ]]; do
    key="$1"
    case $key in
        -h|--help)
        help
        exit 0
        ;;
        --julia)
        JULIA="$2"
        shift
        shift
        ;;
        "-"|"--")
        shift
        break
        ;;
        *)
        POSITIONAL+=("$1")  # Unknown option, save it in an array for later
        shift
        ;;
    esac
done
set -- "${POSITIONAL[@]}"  # Restore positional parameters

# Check arguments: Everything remaining should be configuration files
if [[ $# -eq 0 ]]; then
    help
    exit 1
fi

SCRIPT_DIR=$( cd "$(dirname "${BASH_SOURCE[0]}")" ; pwd -P )

if ! command -v $JULIA &> /dev/null; then
    echo "Error: Could not locate '$JULIA' executable"
    exit 1
fi

# Validate all files in one Julia session to pay the startup and package load once
JULIA_CMD=$(
    cat << 'EOF'
try
    using JSON
    using JSONSchema
catch
    using Pkg; Pkg.UPDATED_REGISTRY_THIS_SESSION[] = true
    Pkg.activate(; temp=true); Pkg.add(["JSON", "JSONSchema"])
end
script_dir = ARGS[1]
include(joinpath(script_dir, "schema", "ValidateConfig.jl"))
using .ValidateConfig
schema_file = joinpath(script_dir, "schema", "config-schema.json")
failed = String[]
for config_file in ARGS[2:end]
    try
        result = validate_config_file(; config_file=config_file, schema_file=schema_file)
        if result != nothing
            println("Dry-run: Configuration file \"$config_file\" contains errors!")
            show(stdout, MIME("text/plain"), result)
            println()
            push!(failed, config_file)
        else
            println("Dry-run: No errors detected in configuration file \"$config_file\"")
        end
    catch e
        println("Dry-run: Configuration file \"$config_file\" could not be validated!")
        showerror(stdout, e)
        println()
        push!(failed, config_file)
    end
end
isempty(failed) || error("Validation failed for: " * join(failed, ", "))
EOF
)
$JULIA -e "$JULIA_CMD" -- "$SCRIPT_DIR" "$@"
