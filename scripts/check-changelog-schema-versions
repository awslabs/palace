#!/bin/bash

# Copyright Amazon.com, Inc. or its affiliates. All Rights Reserved.
# SPDX-License-Identifier: Apache-2.0

help()
{
    echo "Usage: check-changelog-schema-versions [OPTIONS] [CHANGELOG]

Fail if CHANGELOG contains duplicate SchemaVer X-Y-Z entries.

Options:
  -h, --help                       Show this help message and exit
      --self-test                  Run built-in self-tests and exit

Arguments:
  CHANGELOG                        Changelog file to scan (default: CHANGELOG.md)
"
}

self_test()
{
    local tmpdir unique duplicate output script

    script="${BASH_SOURCE[0]}"
    tmpdir=$(mktemp -d) || return 1
    unique="${tmpdir}/unique.md"
    duplicate="${tmpdir}/duplicate.md"

    printf '%s\n' 'SchemaVer 1-0-0' 'SchemaVer 1-1-0' > "${unique}"
    if ! output=$(bash "${script}" "${unique}" 2>&1); then
        echo "Self-test failed: unique SchemaVer entries were rejected"
        echo "${output}"
        rm -rf "${tmpdir}"
        return 1
    fi

    printf '%s\n' 'SchemaVer 2-0-0' 'SchemaVer 2-0-0' > "${duplicate}"
    if output=$(bash "${script}" "${duplicate}" 2>&1); then
        echo "Self-test failed: duplicate SchemaVer entries were accepted"
        echo "${output}"
        rm -rf "${tmpdir}"
        return 1
    fi
    if ! grep -q 'SchemaVer 2-0-0' <<< "${output}"; then
        echo "Self-test failed: duplicate SchemaVer version was not reported"
        echo "${output}"
        rm -rf "${tmpdir}"
        return 1
    fi

    rm -rf "${tmpdir}"
    echo "check-changelog-schema-versions self-test passed"
    return 0
}

POSITIONAL=()
while [[ $# -gt 0 ]]; do
    case "$1" in
        -h|--help)
            help
            exit 0
            ;;
        --self-test)
            self_test
            exit $?
            ;;
        *)
            POSITIONAL+=("$1")
            shift
            ;;
    esac
done
set -- "${POSITIONAL[@]}"

CHANGELOG="${1:-CHANGELOG.md}"

if [[ ! -f "${CHANGELOG}" ]]; then
    echo "Error: changelog file '${CHANGELOG}' does not exist"
    exit 1
fi

VERSIONS=$(grep -Eo 'SchemaVer[[:space:]]+[0-9]+-[0-9]+-[0-9]+' "${CHANGELOG}" |
    awk '{ print $2 }' || true)
DUPLICATES=$(printf '%s\n' "${VERSIONS}" | sed '/^$/d' | sort | uniq -d)

if [[ -n "${DUPLICATES}" ]]; then
    echo "Error: Found duplicate SchemaVer entries in ${CHANGELOG}:"
    while IFS= read -r version; do
        lines=$(grep -En "SchemaVer[[:space:]]+${version}([^0-9-]|$)" "${CHANGELOG}" |
            cut -d: -f1 | paste -sd, -)
        echo "  SchemaVer ${version} (lines ${lines})"
    done <<< "${DUPLICATES}"
    exit 1
fi

echo "All SchemaVer entries in ${CHANGELOG} are unique"
exit 0
